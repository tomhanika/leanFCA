/-!
# Scaling dimension in the scale-hierarchy

The *scaling dimension* of a context with respect to a family of scales asks how many scales of
that family are needed to represent the context. This file phrases the notion inside the lattice
`FCA.ClosureSubsystem r` of closure systems of extents, which is the scale-hierarchy of `r`:
a closure system `𝒜` has scaling dimension at most `|ι|` with respect to a property `P` if it
is the join of an `ι`-indexed family of closure systems satisfying `P`.

For *ordinal* scales the property is that the closed sets form a chain. As for the order
dimension (`FCA.HasRealizer`) we do not define a numeric dimension but the predicate "at most
`|ι|`".

## Main definitions

* `FCA.ClosureSubsystem.IsOrdinal 𝒜`: the closed sets of `𝒜` form a chain.
* `FCA.ClosureSubsystem.HasCover P 𝒜 ι`: `𝒜` is the join of `ι` closure systems satisfying `P`.
* `FCA.ClosureSubsystem.HasOrdinalCover 𝒜 ι`: the ordinal scaling dimension of `𝒜` is at most
  `|ι|`.

## Main results

* `FCA.ClosureSubsystem.isOrdinal_iff_isFerrers`: `𝒜` is ordinal iff the incidence of its
  canonical scale is a Ferrers relation.
* `FCA.ClosureSubsystem.HasOrdinalCover.hasRealizer_concept`: the order dimension of the concept
  lattice of a scale-measure is at most its ordinal scaling dimension.
* `FCA.ClosureSubsystem.hasOrdinalCover_iff_irreducibles`: for finitely many objects, the
  ordinal scaling dimension of `𝒜` is at most `|ι|` iff the `⋂`-irreducible closed sets of `𝒜`
  can be covered by `ι` chains. The implication from left to right needs no finiteness.

## References

* [B. Ganter, T. Hanika, J. Hirth, *Scaling Dimension*][ganter2023]
* [T. Hanika, J. Hirth, *On the Lattice of Conceptual Measurements*][hanika2022]
-/

@[expose] public section

open Set Function Order

namespace FCA

namespace ClosureSubsystem

variable {α β ι κ : Type*} {r : α → β → Prop} {𝒜 ℬ : ClosureSubsystem r} {A B : Set α}
  {P Q : ClosureSubsystem r → Prop}

/-! ### Ordinal closure systems -/

/-- A closure system of extents is *ordinal* if its closed sets form a chain. These are the
closure systems of scale-measures into ordinal scales. -/
def IsOrdinal (𝒜 : ClosureSubsystem r) : Prop :=
  ∀ ⦃A B⦄, A ∈ 𝒜 → B ∈ 𝒜 → A ⊆ B ∨ B ⊆ A

theorem IsOrdinal.mono (h : ℬ.IsOrdinal) (hle : 𝒜 ≤ ℬ) : 𝒜.IsOrdinal :=
  fun _ _ hA hB ↦ h (le_def.1 hle hA) (le_def.1 hle hB)

theorem isOrdinal_bot : (⊥ : ClosureSubsystem r).IsOrdinal := fun A B hA _ ↦ by
  rw [mem_bot.1 hA]
  exact .inr (subset_univ B)

/-- A closure system is ordinal iff the incidence of its canonical scale is a Ferrers
relation. -/
theorem isOrdinal_iff_isFerrers : 𝒜.IsOrdinal ↔ IsFerrers 𝒜.context := by
  constructor
  · intro h a A a' A' ha ha'
    rcases h A.2 A'.2 with hsub | hsub
    · exact .inl (hsub ha)
    · exact .inr (hsub ha')
  · intro h A B hA hB
    exact h.isExtent_total (isExtent_context_iff.2 hA) (isExtent_context_iff.2 hB)

theorem closure_mono (𝒜 : ClosureSubsystem r) (h : A ⊆ B) : 𝒜.closure A ⊆ 𝒜.closure B :=
  closure_subset closure_mem (h.trans subset_closure)

theorem IsOrdinal.isFerrers_closure (h : 𝒜.IsOrdinal) :
    IsFerrers fun (a : α) (A : Set α) ↦ a ∈ 𝒜.closure A :=
  fun _ A _ A' ha ha' ↦ (h (closure_mem (A := A)) (closure_mem (A := A'))).elim
    (fun hs ↦ .inl (hs ha)) fun hs ↦ .inr (hs ha')

/-- The closure system generated by a chain of extents is ordinal. -/
theorem isOrdinal_generate {S : Set (Set α)} (hS : IsChain (· ⊆ ·) S) :
    (generate r S).IsOrdinal := by
  rintro _ _ ⟨T₁, hT₁, -, rfl⟩ ⟨T₂, hT₂, -, rfl⟩
  by_cases h : ∀ A ∈ T₁, ∃ B ∈ T₂, B ⊆ A
  · refine .inr (subset_sInter fun A hA ↦ ?_)
    obtain ⟨B, hB, hBA⟩ := h A hA
    exact (sInter_subset_of_mem hB).trans hBA
  · push Not at h
    obtain ⟨A, hA, hne⟩ := h
    exact .inl ((sInter_subset_of_mem hA).trans (subset_sInter fun B hB ↦
      (hS.total (hT₁ hA) (hT₂ hB)).resolve_right (hne B hB)))

/-! ### Joins and closures -/

/-- The extents which are the intersection of their closures in the members of a family of
closure systems. -/
def iInterClosure (f : ι → ClosureSubsystem r) : ClosureSubsystem r where
  carrier := {B | IsExtent r B ∧ ⋂ i, (f i).closure B = B}
  sInter_mem' S hS := by
    refine ⟨mem_top.1 ((⊤ : ClosureSubsystem r).sInter_mem fun B hB ↦ mem_top.2 (hS hB).1),
      Subset.antisymm (subset_sInter fun B hB ↦ ?_) (subset_iInter fun _ ↦ subset_closure)⟩
    rw [← (hS hB).2]
    exact iInter_mono fun i ↦ (f i).closure_mono (sInter_subset_of_mem hB)
  isExtent' _ hB := hB.1

/-- A closed set of a join of closure systems is the intersection of its closures in these
closure systems. -/
theorem iInter_closure_eq_of_mem_iSup {f : ι → ClosureSubsystem r} (hA : A ∈ ⨆ i, f i) :
    ⋂ i, (f i).closure A = A := by
  have hle : ⨆ i, f i ≤ iInterClosure f := iSup_le fun i ↦ le_def.2 fun B hB ↦
    ⟨(f i).isExtent hB, Subset.antisymm
      ((iInter_subset _ i).trans (closure_eq_self_iff.2 hB).subset)
      (subset_iInter fun _ ↦ subset_closure)⟩
  exact (le_def.1 hle hA).2

/-! ### Covers and the scaling dimension -/

/-- `𝒜` is the join of an `ι`-indexed family of closure systems satisfying `P`: the scaling
dimension of `𝒜` with respect to `P` is at most the cardinality of `ι`. -/
def HasCover (P : ClosureSubsystem r → Prop) (𝒜 : ClosureSubsystem r) (ι : Type*) : Prop :=
  ∃ f : ι → ClosureSubsystem r, (∀ i, P (f i)) ∧ ⨆ i, f i = 𝒜

theorem HasCover.of_surjective (h : HasCover P 𝒜 ι) (e : κ → ι) (he : Surjective e) :
    HasCover P 𝒜 κ :=
  let ⟨f, hf, hsup⟩ := h
  ⟨f ∘ e, fun k ↦ hf (e k), (he.iSup_comp f).trans hsup⟩

theorem HasCover.mono_pred (h : HasCover P 𝒜 ι) (hPQ : ∀ ℬ, P ℬ → Q ℬ) : HasCover Q 𝒜 ι :=
  let ⟨f, hf, hsup⟩ := h
  ⟨f, fun i ↦ hPQ _ (hf i), hsup⟩

/-- The ordinal scaling dimension of `𝒜` is at most the cardinality of `ι`: `𝒜` is the join of
`ι` ordinal closure systems. -/
abbrev HasOrdinalCover (𝒜 : ClosureSubsystem r) (ι : Type*) : Prop :=
  HasCover IsOrdinal 𝒜 ι

/-- The closure systems of ordinal scaling dimension at most one are the ordinal ones. -/
theorem hasOrdinalCover_unit_iff : 𝒜.HasOrdinalCover Unit ↔ 𝒜.IsOrdinal :=
  ⟨fun ⟨f, hf, hsup⟩ ↦ hsup ▸ (iSup_unique (f := f)).symm ▸ hf default,
    fun h ↦ ⟨fun _ ↦ 𝒜, fun _ ↦ h, iSup_const⟩⟩

/-- An ordinal cover of `𝒜` yields a Ferrers cover of the canonical scale of `𝒜`. -/
theorem HasOrdinalCover.hasFerrersCover (h : 𝒜.HasOrdinalCover ι) :
    HasFerrersCover 𝒜.context ι := by
  obtain ⟨f, hf, rfl⟩ := h
  refine ⟨fun i a A ↦ a ∈ (f i).closure A.1,
    fun i ↦ (hf i).isFerrers_closure.comp id Subtype.val,
    fun a A ↦ ⟨fun ha i ↦ subset_closure ha, fun ha ↦ ?_⟩⟩
  exact (iInter_closure_eq_of_mem_iSup A.2).subset (mem_iInter.2 ha)

/-- The order dimension of the concept lattice of a scale-measure is at most its ordinal
scaling dimension. -/
theorem HasOrdinalCover.hasRealizer_concept (h : 𝒜.HasOrdinalCover ι) :
    HasRealizer (Concept α {A // A ∈ 𝒜} 𝒜.context) ι :=
  hasRealizer_concept_iff.2 h.hasFerrersCover

/-! ### Chain covers of the irreducible closed sets -/

/-- In an ordinal cover of `𝒜`, every `⋂`-irreducible closed set of `𝒜` belongs to one of the
covering closure systems. -/
theorem exists_mem_of_mem_irreducibles {f : ι → ClosureSubsystem r}
    (hA : A ∈ (⨆ i, f i).irreducibles) : ∃ i, A ∈ f i := by
  by_contra hne
  push Not at hne
  refine hA.2 (Subset.antisymm ?_ (subset_sInter fun B hB ↦ hB.2.subset))
  rw [← iInter_closure_eq_of_mem_iSup hA.1]
  refine subset_iInter fun i ↦ sInter_subset_of_mem ⟨le_def.1 (le_iSup f i) closure_mem, ?_⟩
  rw [iInter_closure_eq_of_mem_iSup hA.1]
  exact subset_closure.ssubset_of_ne fun heq ↦ hne i (closure_eq_self_iff.1 heq.symm)

/-- The `⋂`-irreducible closed sets of a closure system of ordinal scaling dimension at most
`|ι|` are covered by `ι` chains. -/
theorem HasOrdinalCover.exists_chains (h : 𝒜.HasOrdinalCover ι) :
    ∃ g : ι → Set (Set α), (∀ i, IsChain (· ⊆ ·) (g i)) ∧ ⋃ i, g i = 𝒜.irreducibles := by
  obtain ⟨f, hf, rfl⟩ := h
  refine ⟨fun i ↦ (f i).carrier ∩ (⨆ i, f i).irreducibles,
    fun i A hA B hB _ ↦ hf i hA.1 hB.1, Subset.antisymm (iUnion_subset fun i ↦ inter_subset_right)
      fun A hA ↦ ?_⟩
  obtain ⟨i, hi⟩ := exists_mem_of_mem_irreducibles hA
  exact mem_iUnion.2 ⟨i, hi, hA⟩

/-- For finitely many objects, the ordinal scaling dimension of `𝒜` is at most `|ι|` iff the
`⋂`-irreducible closed sets of `𝒜` can be covered by `ι` chains. -/
theorem hasOrdinalCover_iff_irreducibles [Finite α] :
    𝒜.HasOrdinalCover ι ↔
      ∃ g : ι → Set (Set α), (∀ i, IsChain (· ⊆ ·) (g i)) ∧ ⋃ i, g i = 𝒜.irreducibles := by
  refine ⟨HasOrdinalCover.exists_chains, fun ⟨g, hg, hirr⟩ ↦
    ⟨fun i ↦ generate r (g i), fun i ↦ isOrdinal_generate (hg i), le_antisymm ?_ ?_⟩⟩
  · refine iSup_le fun i ↦ generate_le_iff.2 fun A hA _ ↦ ?_
    have : A ∈ 𝒜.irreducibles := hirr ▸ mem_iUnion.2 ⟨i, hA⟩
    exact this.1
  · refine 𝒜.le_generate_irreducibles.trans (generate_le_iff.2 fun A hA hext ↦ ?_)
    rw [← hirr] at hA
    obtain ⟨i, hi⟩ := mem_iUnion.1 hA
    exact le_def.1 (le_iSup (fun i ↦ generate r (g i)) i) (generate_le_iff.1 le_rfl A hi hext)

end ClosureSubsystem

end FCA
