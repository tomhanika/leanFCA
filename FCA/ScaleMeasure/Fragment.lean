module

public import FCA.ScaleMeasure.Logical
public import FCA.ScaleMeasure.Structure

/-!
# Scale-measures representable in a fragment of propositional logic

Hanika and Hirth ask for which formulas `φ` the identity is a scale-measure into the scale with
the single logical attribute `φ`, and for logical representations of scale-measures beyond the
conjunctive normal form. This file answers both questions for an arbitrary *fragment*, that is,
an arbitrary set `Φ` of propositional formulas over the attributes of a context `r`.

A closure system `𝒜` of extents of `r` is *representable* in `Φ` if it is the closure system of
the identity measure into a scale whose attributes are formulas from `Φ`. The criterion is that
the members of `𝒜` which are extents of formulas from `Φ` are `⋂`-dense in `𝒜`.

## Main definitions

* `FCA.ClosureSubsystem.definable 𝒜 Φ`: the members of `𝒜` of the form `φ.extent r` for a
  formula `φ ∈ Φ`.
* `FCA.ClosureSubsystem.IsRepresentable 𝒜 Φ`: `𝒜` is the closure system of a scale-measure
  whose scale attributes are formulas from `Φ`.

## Main results

* `FCA.IsScaleMeasure.closureSubsystem_logicalScale`: the closure system of a scale of formulas
  is generated by the extents of these formulas.
* `FCA.ClosureSubsystem.isRepresentable_iff`: `𝒜` is representable in `Φ` iff `𝒜` is generated by
  its `Φ`-definable members.
* `FCA.ClosureSubsystem.isRepresentable_iff_irreducibles`: for finitely many objects, `𝒜` is
  representable in `Φ` iff each of its `⋂`-irreducible members is the extent of a formula from
  `Φ`. The implication from left to right needs no finiteness.
* `FCA.ClosureSubsystem.isRepresentable_isConjunctive`: for finitely many attributes, every
  closure system of extents is representable by conjunctions. Hence no fragment containing the
  conjunctions, in particular not the full propositional logic, represents more scale-measures
  than conjunctions do (`FCA.ClosureSubsystem.isRepresentable_univ_iff_isConjunctive`).
* `FCA.ClosureSubsystem.isRepresentable_isDisjunctive_iff`: for finitely many objects, `𝒜` is
  representable by disjunctions iff each of its `⋂`-irreducible members is a finite union of
  attribute extents.
* `FCA.not_isRepresentable_isDisjunctive_fork`: a closure system of extents of a context with
  three objects and two attributes which is not representable by disjunctions.

## Implementation notes

The criterion answers a question raised in the papers cited below. It is an elementary
consequence of their Lemma 15 and Proposition 16, but it was not found stated in print.

## References

* [T. Hanika, J. Hirth, *On the Lattice of Conceptual Measurements*][hanika2022]
* [T. Hanika, J. Hirth, *Exploring Scale-Measures of Data Sets*][hanika2021]
-/

@[expose] public section

open Set Function Order

namespace FCA

variable {α β : Type*} {r : α → β → Prop}

namespace Formula

/-- A formula has finitely many variables. -/
theorem finite_vars (φ : Formula β) : φ.vars.Finite := by
  induction φ with
  | var b => exact finite_singleton b
  | and φ ψ ih₁ ih₂ => exact ih₁.union ih₂
  | or φ ψ ih₁ ih₂ => exact ih₁.union ih₂
  | not φ ih => exact ih

/-- Every finite nonempty set of attributes is the set of variables of a conjunction. -/
theorem exists_isConjunctive_vars_eq {t : Set β} (ht : t.Finite) (hne : t.Nonempty) :
    ∃ φ : Formula β, φ.IsConjunctive ∧ φ.vars = t := by
  suffices h : ∀ s : Set β, s.Finite → s = ∅ ∨ ∃ φ : Formula β, φ.IsConjunctive ∧ φ.vars = s from
    (h t ht).resolve_left hne.ne_empty
  intro s hs
  induction s, hs using Set.Finite.induction_on with
  | empty => exact .inl rfl
  | @insert a s _ _ ih =>
    refine .inr ?_
    rcases ih with rfl | ⟨φ, hφ, rfl⟩
    · exact ⟨var a, trivial, by simp [vars]⟩
    · exact ⟨and (var a) φ, ⟨trivial, hφ⟩, by simp [vars]⟩

/-- Every finite nonempty set of attributes is the set of variables of a disjunction. -/
theorem exists_isDisjunctive_vars_eq {t : Set β} (ht : t.Finite) (hne : t.Nonempty) :
    ∃ φ : Formula β, φ.IsDisjunctive ∧ φ.vars = t := by
  suffices h : ∀ s : Set β, s.Finite → s = ∅ ∨ ∃ φ : Formula β, φ.IsDisjunctive ∧ φ.vars = s from
    (h t ht).resolve_left hne.ne_empty
  intro s hs
  induction s, hs using Set.Finite.induction_on with
  | empty => exact .inl rfl
  | @insert a s _ _ ih =>
    refine .inr ?_
    rcases ih with rfl | ⟨φ, hφ, rfl⟩
    · exact ⟨var a, trivial, by simp [vars]⟩
    · exact ⟨or (var a) φ, ⟨trivial, hφ⟩, by simp [vars]⟩

/-- The extents of conjunctions are the derivations of finite nonempty sets of attributes. -/
theorem exists_isConjunctive_extent_eq_iff {A : Set α} :
    (∃ φ : Formula β, φ.IsConjunctive ∧ φ.extent r = A) ↔
      ∃ t : Set β, t.Finite ∧ t.Nonempty ∧ lowerPolar r t = A := by
  constructor
  · rintro ⟨φ, hφ, rfl⟩
    exact ⟨φ.vars, φ.finite_vars, φ.vars_nonempty, (extent_of_isConjunctive hφ).symm⟩
  · rintro ⟨t, ht, hne, rfl⟩
    obtain ⟨φ, hφ, rfl⟩ := exists_isConjunctive_vars_eq ht hne
    exact ⟨φ, hφ, extent_of_isConjunctive hφ⟩

/-- The extents of disjunctions are the unions of finitely many, but at least one, attribute
extents. -/
theorem exists_isDisjunctive_extent_eq_iff {A : Set α} :
    (∃ φ : Formula β, φ.IsDisjunctive ∧ φ.extent r = A) ↔
      ∃ t : Set β, t.Finite ∧ t.Nonempty ∧ ⋃ b ∈ t, lowerPolar r {b} = A := by
  constructor
  · rintro ⟨φ, hφ, rfl⟩
    exact ⟨φ.vars, φ.finite_vars, φ.vars_nonempty, (extent_of_isDisjunctive hφ).symm⟩
  · rintro ⟨t, ht, hne, rfl⟩
    obtain ⟨φ, hφ, rfl⟩ := exists_isDisjunctive_vars_eq ht hne
    exact ⟨φ, hφ, extent_of_isDisjunctive hφ⟩

end Formula

/-! ### The closure system of a scale of formulas -/

theorem lowerPolar_restrictAttributes_logicalScale {Ψ : Set (Formula β)} (U : Set Ψ) :
    lowerPolar (restrictAttributes (logicalScale r) Ψ) U =
      ⋂₀ ((fun φ : Ψ ↦ φ.1.extent r) '' U) := by
  ext a
  simp [mem_lowerPolar_iff, restrictAttributes, logicalScale]

/-- The closure system of the scale-measure given by a set `Ψ` of formulas is generated by the
extents of the formulas in `Ψ`. -/
theorem IsScaleMeasure.closureSubsystem_logicalScale {Ψ : Set (Formula β)}
    (h : IsScaleMeasure r (restrictAttributes (logicalScale r) Ψ) id) :
    h.closureSubsystem =
      ClosureSubsystem.generate r ((fun φ : Formula β ↦ φ.extent r) '' Ψ) := by
  refine le_antisymm (ClosureSubsystem.le_def.2 ?_) (ClosureSubsystem.generate_le_iff.2 ?_)
  · rintro _ ⟨_, ⟨U, rfl⟩, rfl⟩
    refine ⟨(fun φ : Ψ ↦ φ.1.extent r) '' U, ?_, ?_, ?_⟩
    · rintro _ ⟨φ, -, rfl⟩
      exact ⟨φ.1, φ.2, rfl⟩
    · rintro _ ⟨φ, -, rfl⟩
      exact isScaleMeasure_logicalScale_iff.1 h φ.1 φ.2
    · rw [preimage_id, lowerPolar_restrictAttributes_logicalScale]
  · rintro _ ⟨φ, hφ, rfl⟩ -
    refine ⟨lowerPolar (restrictAttributes (logicalScale r) Ψ) {⟨φ, hφ⟩}, isExtent_lowerPolar, ?_⟩
    rw [preimage_id, lowerPolar_restrictAttributes_logicalScale]
    simp

namespace ClosureSubsystem

variable {𝒜 : ClosureSubsystem r} {Φ Φ' : Set (Formula β)} {A : Set α}

/-! ### Representability -/

/-- The members of `𝒜` which are the extent of a formula from `Φ`. -/
def definable (𝒜 : ClosureSubsystem r) (Φ : Set (Formula β)) : Set (Set α) :=
  {A | A ∈ 𝒜 ∧ ∃ φ ∈ Φ, φ.extent r = A}

theorem mem_definable : A ∈ 𝒜.definable Φ ↔ A ∈ 𝒜 ∧ ∃ φ ∈ Φ, φ.extent r = A :=
  Iff.rfl

theorem definable_mono (h : Φ ⊆ Φ') : 𝒜.definable Φ ⊆ 𝒜.definable Φ' :=
  fun _ hA ↦ ⟨hA.1, hA.2.imp fun _ hφ ↦ ⟨h hφ.1, hφ.2⟩⟩

theorem generate_definable_le (𝒜 : ClosureSubsystem r) (Φ : Set (Formula β)) :
    generate r (𝒜.definable Φ) ≤ 𝒜 :=
  generate_le_iff.2 fun _ hA _ ↦ hA.1

/-- A closure system `𝒜` of extents is *representable* in the fragment `Φ` if it is the closure
system of the identity measure into a scale whose attributes are formulas from `Φ`. -/
def IsRepresentable (𝒜 : ClosureSubsystem r) (Φ : Set (Formula β)) : Prop :=
  ∃ Ψ ⊆ Φ, ∃ h : IsScaleMeasure r (restrictAttributes (logicalScale r) Ψ) id,
    h.closureSubsystem = 𝒜

/-- **Fragment representability**: a closure system of extents is representable in a fragment
`Φ` iff it is generated by its members which are extents of formulas from `Φ`. -/
theorem isRepresentable_iff : 𝒜.IsRepresentable Φ ↔ 𝒜 = generate r (𝒜.definable Φ) := by
  constructor
  · rintro ⟨Ψ, hΨ, h, rfl⟩
    refine le_antisymm ?_ (generate_definable_le _ _)
    have key := h.closureSubsystem_logicalScale
    rw [key]
    refine generate_le_iff.2 ?_
    rintro _ ⟨φ, hφ, rfl⟩ hext
    have hmem : φ.extent r ∈ h.closureSubsystem := by
      rw [key]
      exact generate_le_iff.1 le_rfl _ ⟨φ, hφ, rfl⟩ hext
    exact generate_le_iff.1 le_rfl _ ⟨key ▸ hmem, φ, hΨ hφ, rfl⟩ hext
  · intro h𝒜
    have hΨ : ∀ φ ∈ {φ | φ ∈ Φ ∧ φ.extent r ∈ 𝒜}, IsExtent r (φ.extent r) :=
      fun φ hφ ↦ 𝒜.isExtent hφ.2
    refine ⟨{φ | φ ∈ Φ ∧ φ.extent r ∈ 𝒜}, fun φ hφ ↦ hφ.1,
      isScaleMeasure_logicalScale_iff.2 hΨ, ?_⟩
    rw [IsScaleMeasure.closureSubsystem_logicalScale, h𝒜]
    congr 1
    ext A
    constructor
    · rintro ⟨φ, hφ, rfl⟩
      exact ⟨h𝒜 ▸ hφ.2, φ, hφ.1, rfl⟩
    · rintro ⟨hA, φ, hφ, rfl⟩
      exact ⟨φ, ⟨hφ, h𝒜 ▸ hA⟩, rfl⟩

theorem isRepresentable_iff_le : 𝒜.IsRepresentable Φ ↔ 𝒜 ≤ generate r (𝒜.definable Φ) :=
  isRepresentable_iff.trans
    ⟨fun h ↦ h.le, fun h ↦ le_antisymm h (generate_definable_le _ _)⟩

/-- A closure system of extents is representable in `Φ` iff each of its members is an
intersection of members which are extents of formulas from `Φ`. -/
theorem isRepresentable_iff_forall :
    𝒜.IsRepresentable Φ ↔ ∀ A ∈ 𝒜, ∃ T ⊆ 𝒜.definable Φ, ⋂₀ T = A := by
  rw [isRepresentable_iff_le]
  refine ⟨fun h A hA ↦ ?_, fun h ↦ le_def.2 fun A hA ↦ ?_⟩
  · obtain ⟨T, hT, -, rfl⟩ := mem_generate.1 (le_def.1 h hA)
    exact ⟨T, hT, rfl⟩
  · obtain ⟨T, hT, rfl⟩ := h A hA
    exact mem_generate.2 ⟨T, hT, fun B hB ↦ 𝒜.isExtent (hT hB).1, rfl⟩

theorem IsRepresentable.mono (h : 𝒜.IsRepresentable Φ) (hΦ : Φ ⊆ Φ') : 𝒜.IsRepresentable Φ' := by
  obtain ⟨Ψ, hΨ, h, rfl⟩ := h
  exact ⟨Ψ, hΨ.trans hΦ, h, rfl⟩

/-! ### Irreducible closed sets -/

/-- If `𝒜` is representable in `Φ`, then every `⋂`-irreducible member of `𝒜` is the extent of a
formula from `Φ`. -/
theorem IsRepresentable.exists_extent_eq (h : 𝒜.IsRepresentable Φ) (hA : A ∈ 𝒜.irreducibles) :
    ∃ φ ∈ Φ, φ.extent r = A := by
  obtain ⟨T, hT, rfl⟩ := isRepresentable_iff_forall.1 h A hA.1
  by_cases hmem : ⋂₀ T ∈ T
  · exact (hT hmem).2
  · refine absurd (Subset.antisymm ?_ (subset_sInter fun B hB ↦ hB.2.subset)) hA.2
    refine sInter_subset_sInter fun B hB ↦ ⟨(hT hB).1, ?_⟩
    exact (sInter_subset_of_mem hB).ssubset_of_ne fun heq ↦ hmem (heq ▸ hB)

/-- For finitely many objects, every closure system of extents is generated by its
`⋂`-irreducible members. -/
theorem le_generate_irreducibles [Finite α] (𝒜 : ClosureSubsystem r) :
    𝒜 ≤ generate r 𝒜.irreducibles := by
  refine le_def.2 fun A ↦ ?_
  refine WellFoundedGT.induction
    (motive := fun A ↦ A ∈ 𝒜 → A ∈ generate r 𝒜.irreducibles) A fun A ih hA ↦ ?_
  by_cases hirr : ⋂₀ {B | B ∈ 𝒜 ∧ A ⊂ B} = A
  · have := sInter_mem (𝒜 := generate r 𝒜.irreducibles) (S := {B | B ∈ 𝒜 ∧ A ⊂ B})
      fun B hB ↦ ih B hB.2 hB.1
    rwa [hirr] at this
  · exact generate_le_iff.1 le_rfl A ⟨hA, hirr⟩ (𝒜.isExtent hA)

/-- For finitely many objects, a closure system of extents is representable in `Φ` iff each of
its `⋂`-irreducible members is the extent of a formula from `Φ`. -/
theorem isRepresentable_iff_irreducibles [Finite α] :
    𝒜.IsRepresentable Φ ↔ ∀ A ∈ 𝒜.irreducibles, ∃ φ ∈ Φ, φ.extent r = A := by
  refine ⟨fun h A hA ↦ h.exists_extent_eq hA, fun h ↦ isRepresentable_iff_le.2 ?_⟩
  refine 𝒜.le_generate_irreducibles.trans (generate_le_iff.2 fun A hA hext ↦ ?_)
  exact generate_le_iff.1 le_rfl A ⟨hA.1, h A hA⟩ hext

/-! ### Conjunctions -/

/-- For finitely many attributes, every closure system of extents is representable by
conjunctions. -/
theorem isRepresentable_isConjunctive [Finite β] (𝒜 : ClosureSubsystem r) :
    𝒜.IsRepresentable {φ | φ.IsConjunctive} := by
  refine isRepresentable_iff_forall.2 fun A hA ↦ ?_
  rcases (upperPolar r A).eq_empty_or_nonempty with hempty | hne
  · refine ⟨∅, empty_subset _, ?_⟩
    rw [sInter_empty, ← (𝒜.isExtent hA).eq, hempty, lowerPolar_empty]
  · obtain ⟨φ, hφ, hvars⟩ := Formula.exists_isConjunctive_vars_eq (toFinite _) hne
    have hext : φ.extent r = A := by
      rw [Formula.extent_of_isConjunctive hφ, hvars, (𝒜.isExtent hA).eq]
    exact ⟨{A}, singleton_subset_iff.2 ⟨hA, φ, hφ, hext⟩, sInter_singleton A⟩

/-- For finitely many attributes, every fragment containing the conjunctions represents every
closure system of extents. -/
theorem isRepresentable_of_isConjunctive_subset [Finite β] (𝒜 : ClosureSubsystem r)
    (hΦ : {φ | φ.IsConjunctive} ⊆ Φ) : 𝒜.IsRepresentable Φ :=
  𝒜.isRepresentable_isConjunctive.mono hΦ

/-- For finitely many attributes, the full propositional logic represents exactly the
scale-measures which conjunctions represent, namely all of them. -/
theorem isRepresentable_univ_iff_isConjunctive [Finite β] :
    𝒜.IsRepresentable univ ↔ 𝒜.IsRepresentable {φ | φ.IsConjunctive} :=
  ⟨fun _ ↦ 𝒜.isRepresentable_isConjunctive, fun h ↦ h.mono (subset_univ _)⟩

/-! ### Disjunctions -/

/-- For finitely many objects, a closure system of extents is representable by disjunctions iff
each of its `⋂`-irreducible members is a union of finitely many, but at least one, attribute
extents. -/
theorem isRepresentable_isDisjunctive_iff [Finite α] :
    𝒜.IsRepresentable {φ | φ.IsDisjunctive} ↔ ∀ A ∈ 𝒜.irreducibles,
      ∃ t : Set β, t.Finite ∧ t.Nonempty ∧ ⋃ b ∈ t, lowerPolar r {b} = A := by
  rw [isRepresentable_iff_irreducibles]
  exact forall₂_congr fun A _ ↦ Formula.exists_isDisjunctive_extent_eq_iff

end ClosureSubsystem

/-! ### A closure system which is not representable by disjunctions -/

/-- A context with three objects and two attributes: the object `0` has both attributes, the
object `1` only the attribute `0`, and the object `2` only the attribute `1`. -/
def fork : Fin 3 → Fin 2 → Prop :=
  fun a b ↦ a = 0 ∨ a = b.succ

theorem isExtent_fork_singleton : IsExtent fork ({0} : Set (Fin 3)) := by
  refine ⟨univ, Set.ext fun a ↦ ⟨fun h ↦ ?_, ?_⟩⟩
  · rcases h (mem_univ 0) with h0 | h0
    · exact h0
    · rcases h (mem_univ 1) with h1 | h1
      · exact h1
      · exact absurd (h0.symm.trans h1) (by decide)
  · rintro rfl b -
    exact .inl rfl

/-- The extent of a disjunction over the context `fork` contains an object other than `0`. -/
theorem exists_ne_zero_mem_extent_fork {φ : Formula (Fin 2)} (hφ : φ.IsDisjunctive) :
    ∃ a : Fin 3, a ≠ 0 ∧ a ∈ φ.extent fork := by
  obtain ⟨b, hb⟩ := φ.vars_nonempty
  refine ⟨b.succ, Fin.succ_ne_zero b, ?_⟩
  rw [Formula.extent_of_isDisjunctive hφ]
  exact mem_biUnion hb fun _ hb' ↦ .inr (congrArg Fin.succ (mem_singleton_iff.1 hb').symm)

/-- Disjunctions are a genuinely restrictive fragment: the closure system `{G, {0}}` of extents
of `fork` is not representable by disjunctions, although `{0}` is the extent of the conjunction
of the two attributes. -/
theorem not_isRepresentable_isDisjunctive_fork :
    ¬(ClosureSubsystem.pair ({0} : Set (Fin 3)) isExtent_fork_singleton).IsRepresentable
      {φ | φ.IsDisjunctive} := by
  intro h
  have hirr : ({0} : Set (Fin 3)) ∈
      (ClosureSubsystem.pair ({0} : Set (Fin 3)) isExtent_fork_singleton).irreducibles := by
    refine ⟨ClosureSubsystem.self_mem_pair, fun heq ↦ ?_⟩
    have h1 : (1 : Fin 3) ∈ ⋂₀ {B | B ∈ ClosureSubsystem.pair ({0} : Set (Fin 3))
        isExtent_fork_singleton ∧ ({0} : Set (Fin 3)) ⊂ B} := by
      rintro B ⟨hB, hlt⟩
      rcases ClosureSubsystem.mem_pair.1 hB with rfl | rfl
      · exact mem_univ _
      · exact absurd rfl hlt.ne
    rw [heq] at h1
    exact absurd h1 (by decide)
  obtain ⟨φ, hφ, hext⟩ := h.exists_extent_eq hirr
  obtain ⟨a, ha, hmem⟩ := exists_ne_zero_mem_extent_fork hφ
  rw [hext] at hmem
  exact ha hmem

/-- The same closure system is representable by conjunctions. -/
theorem isRepresentable_isConjunctive_fork :
    (ClosureSubsystem.pair ({0} : Set (Fin 3)) isExtent_fork_singleton).IsRepresentable
      {φ | φ.IsConjunctive} :=
  ClosureSubsystem.isRepresentable_isConjunctive _

end FCA
