/-!
# The structure of the lattice of closure systems contained in a closure system

This file describes the lattice `FCA.ClosureSubsystem p` of closure systems contained in a
closure system `p`, following the classical theory of the lattice of closure systems (Caspard
and Monjardet). The members of `p` are called the *closed sets*.

## Main definitions

* `FCA.ClosureSubsystem.pair A hA`: the closure system `{univ, A}`.
* `FCA.ClosureSubsystem.erase A hA`: all closed sets except `A`.
* `FCA.ClosureSubsystem.respecting p A C`: the closed sets `B` with `A ⊆ B → C ⊆ B`.
* `FCA.ClosureSubsystem.coverEquivInfIrred`: for a finite ground set, the covering pairs of
  closed sets correspond to the meet-irreducible closure systems.
* `FCA.ClosureSubsystem.joinPseudocompl`: the join-pseudocomplement.
* `FCA.ClosureSubsystem.irreducibles`: the closed sets of a closure system which are not
  intersections of other closed sets.

## Main results

* `FCA.ClosureSubsystem.isAtom_iff`: the atoms are the closure systems `{univ, A}`, and the
  lattice is atomistic.
* `FCA.ClosureSubsystem.covBy_iff`: `𝒜` is covered by `ℬ` if and only if `ℬ` has exactly one
  closed set more than `𝒜`.
* The lattice is lower semimodular, and for a finite ground set graded by `|𝒜| - 1`.
* `FCA.ClosureSubsystem.isCoatom_iff`: the coatoms are obtained by removing one closed set which
  is not an intersection of other closed sets.
* `FCA.ClosureSubsystem.infIrred_respecting_iff`: `respecting p A C` is meet-irreducible if and
  only if `C` covers `A` among the closed sets. Every closure system is an infimum of such
  elements (`FCA.ClosureSubsystem.sInf_respecting_closure`), and for a finite ground set every
  meet-irreducible element has this form (`FCA.ClosureSubsystem.InfIrred.exists_respecting`).
* `FCA.ClosureSubsystem.sup_inf_le_iff_total`: the lattice is distributive if and only if the
  closed sets form a chain.
* `FCA.ClosureSubsystem.sup_eq_sup_inf_of_sup_eq_sup`: if the closed sets satisfy the ascending
  chain condition, in particular for a finite ground set, the lattice is join-semidistributive.
* `FCA.ClosureSubsystem.isLeast_joinPseudocompl`: under the same condition the lattice is
  join-pseudocomplemented. The join-pseudocomplement of `𝒜` is generated by the closed sets
  which are not intersections of other closed sets and do not belong to `𝒜`
  (`FCA.ClosureSubsystem.joinPseudocompl_eq_generate`).
* `FCA.ClosureSubsystem.IccCoreIso`: the lattice is meet-distributive, that is, the interval
  between a closure system and the meet of its lower covers is a powerset lattice.

The lattice is an instance of the general classes `FCA.IsJoinSemidistrib`,
`FCA.IsJoinPseudocomplemented` (both under the ascending chain condition) and
`FCA.IsMeetDistrib`.

## Implementation notes

Only the grading and the classification of all meet-irreducible elements need finiteness.
Join-semidistributivity and join-pseudocomplements need the ascending chain condition
`FCA.IsNoetherianClosureSystem` on the closed sets; `FCA.Order.ClosureSubsystem.Counterexample`
shows that they fail without it.

In the dual language of closure operators on a complete lattice, the results under the ascending
chain condition are known: the existence of join-pseudocomplements and their description by
irreducible closed sets is due to Ranzato, and join-semidistributivity follows from the weak
relative pseudocomplements of Giacobazzi, Palamidessi and Ranzato.

## References

* [N. Caspard, B. Monjardet, *The lattices of closure systems, closure operators, and
  implicational systems on a finite set: a survey*][caspard2003]
* [R. Giacobazzi, C. Palamidessi, F. Ranzato, *Weak relative pseudo-complements of closure
  operators*][giacobazzi1996]
* [F. Ranzato, *Pseudocomplements of closure operators on posets*][ranzato2002]
-/

@[expose] public section

open Set Function Order

namespace FCA

namespace ClosureSubsystem

variable {α : Type*} {p : Set α → Prop} [IsClosureSystem p] {𝒜 ℬ 𝒞 : ClosureSubsystem p}
  {A B C : Set α}

instance [Finite α] : Finite (ClosureSubsystem p) :=
  Finite.of_injective carrier carrier_injective

/-! ### Atoms -/

/-- The closure system `{G, A}` for a closed set `A`. -/
def pair (A : Set α) (hA : p A) : ClosureSubsystem p where
  carrier := {univ, A}
  sInter_mem' S hS := by
    rw [mem_insert_iff, mem_singleton_iff]
    by_cases h : A ∈ S
    · refine .inr (Subset.antisymm (sInter_subset_of_mem h) (subset_sInter fun B hB ↦ ?_))
      rcases hS hB with rfl | rfl
      exacts [subset_univ _, Subset.rfl]
    · refine .inl (sInter_eq_univ.2 fun B hB ↦ ?_)
      rcases hS hB with rfl | rfl
      exacts [rfl, absurd hB h]
  isClosed' := by
    rintro _ (rfl | rfl)
    exacts [IsClosureSystem.univ_mem, hA]

@[simp]
theorem mem_pair {hA : p A} : B ∈ pair A hA ↔ B = univ ∨ B = A :=
  Iff.rfl

theorem self_mem_pair {hA : p A} : A ∈ pair A hA :=
  .inr rfl

@[simp]
theorem pair_le_iff {hA : p A} : pair A hA ≤ 𝒜 ↔ A ∈ 𝒜 := by
  refine ⟨fun h ↦ le_def.1 h self_mem_pair, fun h ↦ le_def.2 fun B hB ↦ ?_⟩
  rcases hB with rfl | rfl
  exacts [𝒜.univ_mem, h]

theorem pair_ne_bot {hA : p A} (h : A ≠ univ) : pair A hA ≠ ⊥ :=
  fun hbot ↦ h (mem_bot.1 (hbot ▸ self_mem_pair))

/-- The closure system `{G, A}` is an atom of the lattice of closure systems. -/
theorem isAtom_pair {hA : p A} (h : A ≠ univ) : IsAtom (pair A hA) := by
  refine ⟨pair_ne_bot h, fun 𝒞 h𝒞 ↦ eq_bot_iff.2 (le_def.2 fun B hB ↦ mem_bot.2 ?_)⟩
  rcases le_def.1 h𝒞.le hB with rfl | rfl
  · rfl
  · exact absurd (pair_le_iff.2 hB) h𝒞.not_ge

/-- The atoms of the lattice of closure systems are the closure systems `{G, A}`. -/
theorem isAtom_iff :
    IsAtom 𝒜 ↔ ∃ (A : Set α) (hA : p A), A ≠ univ ∧ 𝒜 = pair A hA := by
  constructor
  · intro h
    obtain ⟨A, hA, hne⟩ : ∃ A ∈ 𝒜, A ≠ univ := by
      by_contra! hall
      exact h.1 (eq_bot_iff.2 (le_def.2 fun B hB ↦ mem_bot.2 (hall B hB)))
    refine ⟨A, 𝒜.isClosed hA, hne, ?_⟩
    rcases h.le_iff.1 (pair_le_iff.2 hA : pair A (𝒜.isClosed hA) ≤ 𝒜) with h' | h'
    · exact absurd h' (pair_ne_bot hne)
    · exact h'.symm
  · rintro ⟨A, hA, hne, rfl⟩
    exact isAtom_pair hne

/-- Every closure system is the supremum of the atoms below it. -/
instance : IsAtomistic (ClosureSubsystem p) where
  isLUB_atoms 𝒜 := by
    refine ⟨{𝒟 | IsAtom 𝒟 ∧ 𝒟 ≤ 𝒜}, ⟨fun 𝒟 h ↦ h.2, fun ℬ hℬ ↦ le_def.2 fun A hA ↦ ?_⟩,
      fun 𝒟 h ↦ h.1⟩
    by_cases hne : A = univ
    · exact hne ▸ ℬ.univ_mem
    · exact pair_le_iff.1 (hℬ ⟨isAtom_pair (hA := 𝒜.isClosed hA) hne, pair_le_iff.2 hA⟩)

/-! ### The covering relation -/

theorem mem_sup_pair {hA : p A} : B ∈ 𝒜 ⊔ pair A hA ↔ B ∈ 𝒜 ∨ ∃ C ∈ 𝒜, C ∩ A = B := by
  rw [mem_sup]
  constructor
  · rintro ⟨C, hC, D, rfl | rfl, rfl⟩
    · exact .inl (by rwa [inter_univ])
    · exact .inr ⟨C, hC, rfl⟩
  · rintro (hB | ⟨C, hC, rfl⟩)
    · exact ⟨B, hB, univ, .inl rfl, inter_univ B⟩
    · exact ⟨C, hC, A, .inr rfl, rfl⟩

/-- If `ℬ` covers `𝒜`, then `ℬ` is generated by `𝒜` and any closed set of `ℬ` not in `𝒜`. -/
theorem sup_pair_eq_of_covBy (h : 𝒜 ⋖ ℬ) (hA : A ∈ ℬ) (hA' : A ∉ 𝒜) :
    𝒜 ⊔ pair A (ℬ.isClosed hA) = ℬ := by
  have hlt : 𝒜 < 𝒜 ⊔ pair A (ℬ.isClosed hA) :=
    lt_of_le_of_ne le_sup_left fun heq ↦ hA' (heq ▸ le_def.1 le_sup_right self_mem_pair)
  exact (sup_le h.le (pair_le_iff.2 hA)).eq_of_not_lt (h.2 hlt)

/-- A closure system is covered by another one if and only if the latter has exactly
one closed set more. -/
theorem covBy_iff : 𝒜 ⋖ ℬ ↔ ∃ A, A ∉ 𝒜 ∧ ℬ.carrier = insert A 𝒜.carrier := by
  constructor
  · intro h
    obtain ⟨A, hA, hA'⟩ : ∃ A ∈ ℬ, A ∉ 𝒜 := by
      by_contra! hall
      exact h.lt.not_ge (le_def.2 hall)
    refine ⟨A, hA', Subset.antisymm (fun B hB ↦ ?_) (insert_subset hA (le_def.1 h.le))⟩
    by_contra hB'
    rw [mem_insert_iff, not_or] at hB'
    have h₁ : B ∈ 𝒜 ⊔ pair A (ℬ.isClosed hA) := by rwa [sup_pair_eq_of_covBy h hA hA']
    have h₂ : A ∈ 𝒜 ⊔ pair B (ℬ.isClosed hB) := by rwa [sup_pair_eq_of_covBy h hB hB'.2]
    rcases mem_sup_pair.1 h₁ with h₁ | ⟨C, -, hC⟩
    · exact hB'.2 h₁
    rcases mem_sup_pair.1 h₂ with h₂ | ⟨D, -, hD⟩
    · exact hA' h₂
    exact hB'.1 (Subset.antisymm (hC ▸ inter_subset_right) (hD ▸ inter_subset_right))
  · rintro ⟨A, hA, hℬ⟩
    have hAℬ : A ∈ ℬ := mem_carrier.1 (hℬ ▸ mem_insert A _)
    have hle : 𝒜 ≤ ℬ := le_def.2 fun B hB ↦ mem_carrier.1 (hℬ ▸ mem_insert_of_mem A hB)
    refine ⟨lt_of_le_of_ne hle fun heq ↦ hA (heq ▸ hAℬ), fun 𝒞 h𝒜𝒞 h𝒞ℬ ↦ ?_⟩
    by_cases hA𝒞 : A ∈ 𝒞
    · refine h𝒞ℬ.not_ge (le_def.2 fun B hB ↦ ?_)
      rcases (hℬ ▸ mem_carrier.2 hB : B ∈ insert A 𝒜.carrier) with rfl | hB
      exacts [hA𝒞, le_def.1 h𝒜𝒞.le hB]
    · refine h𝒜𝒞.not_ge (le_def.2 fun B hB ↦ ?_)
      rcases (hℬ ▸ mem_carrier.2 (le_def.1 h𝒞ℬ.le hB) : B ∈ insert A 𝒜.carrier) with rfl | hB
      exacts [absurd hB hA𝒞, hB]

/-- The lattice of closure systems is lower semimodular. -/
instance : IsLowerModularLattice (ClosureSubsystem p) where
  inf_covBy_of_covBy_sup {𝒜 ℬ} h := by
    obtain ⟨A, hA, hsup⟩ := covBy_iff.1 h
    have hsub : ∀ B ∈ ℬ, B = A ∨ B ∈ 𝒜 := fun B hB ↦
      (hsup ▸ mem_carrier.2 (le_def.1 le_sup_right hB) : B ∈ insert A 𝒜.carrier)
    have hAℬ : A ∈ ℬ := by
      by_contra hAℬ
      have hle : ℬ ≤ 𝒜 := le_def.2 fun B hB ↦ (hsub B hB).resolve_left fun h ↦ hAℬ (h ▸ hB)
      exact h.lt.ne (sup_eq_left.2 hle).symm
    refine covBy_iff.2 ⟨A, fun h ↦ hA (mem_inf.1 h).1, Set.ext fun B ↦ ?_⟩
    simp only [mem_carrier, mem_insert_iff, mem_inf]
    refine ⟨fun hB ↦ (hsub B hB).imp_right fun h ↦ ⟨h, hB⟩, ?_⟩
    rintro (rfl | hB)
    exacts [hAℬ, hB.2]

section Finite

variable [Finite α]

/-- A cover in the lattice of closure systems has exactly one closed set more. -/
theorem ncard_carrier_of_covBy (h : 𝒜 ⋖ ℬ) : ℬ.carrier.ncard = 𝒜.carrier.ncard + 1 := by
  obtain ⟨A, hA, hℬ⟩ := covBy_iff.1 h
  rw [hℬ, ncard_insert_of_notMem hA]

omit [IsClosureSystem p] in
theorem ncard_carrier_pos (𝒜 : ClosureSubsystem p) : 0 < 𝒜.carrier.ncard :=
  (ncard_pos).2 ⟨univ, 𝒜.univ_mem⟩

/-- For a finite ground set the lattice of closure systems is graded: the rank of a
closure system `𝒜` is `|𝒜| - 1`. -/
noncomputable instance : GradeMinOrder ℕ (ClosureSubsystem p) where
  grade 𝒜 := 𝒜.carrier.ncard - 1
  grade_strictMono 𝒜 ℬ h := by
    have := ncard_lt_ncard (show 𝒜.carrier ⊂ ℬ.carrier from h)
    have := ncard_carrier_pos 𝒜
    lia
  covBy_grade 𝒜 ℬ h := by
    have := ncard_carrier_of_covBy h
    have := ncard_carrier_pos 𝒜
    rw [Nat.covBy_iff_add_one_eq]
    lia
  isMin_grade 𝒜 h := by
    rw [h.eq_bot, bot_eq]
    simp [trivial]

theorem grade_eq (𝒜 : ClosureSubsystem p) : grade ℕ 𝒜 = 𝒜.carrier.ncard - 1 :=
  rfl

end Finite

/-! ### Coatoms -/

/-- The closure system of all closed sets except `A`, where `A` is not an intersection of other
closed sets. -/
def erase (A : Set α) (hA : ⋂₀ {B | p B ∧ A ⊂ B} ≠ A) : ClosureSubsystem p where
  carrier := {B | p B ∧ B ≠ A}
  sInter_mem' S hS := by
    refine ⟨IsClosureSystem.sInter_mem (p := p) fun B hB ↦ (hS hB).1,
      fun heq ↦ hA (Subset.antisymm ?_ ?_)⟩
    · refine (sInter_subset_sInter fun B hB ↦ ?_).trans heq.subset
      have hAB : A ⊆ B := heq ▸ sInter_subset_of_mem hB
      exact ⟨(hS hB).1, hAB.ssubset_of_ne (hS hB).2.symm⟩
    · exact subset_sInter fun B hB ↦ hB.2.subset
  isClosed' _ hB := hB.1

@[simp]
theorem mem_erase {hA : ⋂₀ {B | p B ∧ A ⊂ B} ≠ A} :
    B ∈ erase A hA ↔ p B ∧ B ≠ A :=
  Iff.rfl

/-- The coatoms of the lattice of closure systems are obtained by removing a closed set
that is not an intersection of other closed sets. -/
theorem isCoatom_iff : IsCoatom 𝒜 ↔ ∃ A, p A ∧ ⋂₀ {B | p B ∧ A ⊂ B} ≠ A ∧
    𝒜.carrier = {B | p B ∧ B ≠ A} := by
  rw [← covBy_top_iff, covBy_iff]
  constructor
  · rintro ⟨A, hA, htop⟩
    have hmem : ∀ B, p B → B = A ∨ B ∈ 𝒜 := fun B hB ↦
      (htop ▸ mem_carrier.2 (mem_top.2 hB) : B ∈ insert A 𝒜.carrier)
    refine ⟨A, mem_top.1 (mem_carrier.1 (htop ▸ mem_insert A _)), fun heq ↦ hA ?_, ?_⟩
    · rw [← heq]
      exact 𝒜.sInter_mem fun B hB ↦ (hmem B hB.1).resolve_left hB.2.ne'
    · ext B
      exact ⟨fun hB ↦ ⟨𝒜.isClosed hB, fun h ↦ hA (h ▸ hB)⟩,
        fun hB ↦ (hmem B hB.1).resolve_left hB.2⟩
  · rintro ⟨A, hA, -, h𝒜⟩
    refine ⟨A, fun h ↦ (h𝒜 ▸ mem_carrier.2 h : A ∈ {B | p B ∧ B ≠ A}).2 rfl, ?_⟩
    ext B
    rw [mem_carrier, mem_top, h𝒜, mem_insert_iff]
    by_cases hB : B = A
    · simp [hB, hA]
    · simp [hB]

theorem isCoatom_erase {hA : ⋂₀ {B | p B ∧ A ⊂ B} ≠ A} (hA' : p A) :
    IsCoatom (erase A hA) :=
  isCoatom_iff.2 ⟨A, hA', hA, rfl⟩

/-! ### Meet-irreducible elements -/

/-- The closure system of all closed sets `B` that respect the implication `A → C` between
sets: if `A ⊆ B` then `C ⊆ B`. -/
def respecting (p : Set α → Prop) [IsClosureSystem p] (A C : Set α) : ClosureSubsystem p where
  carrier := {B | p B ∧ (A ⊆ B → C ⊆ B)}
  sInter_mem' _ hS := ⟨IsClosureSystem.sInter_mem (p := p) fun _ hB ↦ (hS hB).1, fun h ↦
    subset_sInter fun _ hB ↦ (hS hB).2 (h.trans (sInter_subset_of_mem hB))⟩
  isClosed' _ hB := hB.1

@[simp]
theorem mem_respecting : B ∈ respecting p A C ↔ p B ∧ (A ⊆ B → C ⊆ B) :=
  Iff.rfl

theorem le_respecting_iff : 𝒜 ≤ respecting p A C ↔ ∀ B ∈ 𝒜, A ⊆ B → C ⊆ B :=
  ⟨fun h _ hB ↦ (le_def.1 h hB).2, fun h ↦ le_def.2 fun B hB ↦ ⟨𝒜.isClosed hB, h B hB⟩⟩

theorem notMem_respecting (h : A ⊂ C) : A ∉ respecting p A C :=
  fun hA ↦ h.not_subset (hA.2 Subset.rfl)

/-- Splitting an implication at an intermediate set. -/
theorem respecting_inf_respecting {D : Set α} (hAD : A ⊆ D) (hDC : D ⊆ C) :
    respecting p A D ⊓ respecting p D C = respecting p A C := by
  ext B
  simp only [mem_carrier, mem_inf, mem_respecting]
  exact ⟨fun h ↦ ⟨h.1.1, fun hA ↦ h.2.2 (h.1.2 hA)⟩, fun h ↦
    ⟨⟨h.1, fun hA ↦ hDC.trans (h.2 hA)⟩, h.1, fun hD ↦ h.2 (hAD.trans hD)⟩⟩

/-- A pair of closed sets `A ⊂ C` is determined by the closure system `respecting p A C`. -/
theorem respecting_inj {A' C' : Set α} (hA : p A) (hC : p C) (hAC : A ⊂ C)
    (hA' : p A') (hC' : p C') (hAC' : A' ⊂ C') :
    respecting p A C = respecting p A' C' ↔ A = A' ∧ C = C' := by
  refine ⟨fun h ↦ ?_, fun h ↦ by rw [h.1, h.2]⟩
  have h₁ : A' ⊆ A := by
    by_contra hsub
    have hmem : A ∈ respecting p A' C' := ⟨hA, fun h' ↦ absurd h' hsub⟩
    rw [← h] at hmem
    exact notMem_respecting hAC hmem
  have h₂ : A ⊆ A' := by
    by_contra hsub
    have hmem : A' ∈ respecting p A C := ⟨hA', fun h' ↦ absurd h' hsub⟩
    rw [h] at hmem
    exact notMem_respecting hAC' hmem
  obtain rfl := Subset.antisymm h₂ h₁
  have h₃ : C ∈ respecting p A C' := h ▸ ⟨hC, fun _ ↦ Subset.rfl⟩
  have h₄ : C' ∈ respecting p A C := h ▸ ⟨hC', fun _ ↦ Subset.rfl⟩
  exact ⟨rfl, Subset.antisymm (h₄.2 hAC'.subset) (h₃.2 hAC.subset)⟩

/-- If `C` covers `A` among the closed sets, every closure system strictly above
`respecting p A C` contains `A`. -/
theorem mem_of_respecting_lt (hC : p C) (hAC : A ⊆ C)
    (hcov : ∀ D, p D → A ⊆ D → D ⊆ C → D = A ∨ D = C)
    (h : respecting p A C < 𝒜) : A ∈ 𝒜 := by
  obtain ⟨B, hB, hB'⟩ : ∃ B ∈ 𝒜, B ∉ respecting p A C := by
    by_contra! hall
    exact h.not_ge (le_def.2 hall)
  have hB' : A ⊆ B ∧ ¬C ⊆ B := by
    simpa [mem_respecting, 𝒜.isClosed hB] using hB'
  have hC𝒜 : C ∈ 𝒜 := le_def.1 h.le ⟨hC, fun _ ↦ Subset.rfl⟩
  rcases hcov (B ∩ C) (IsClosureSystem.inter_mem (𝒜.isClosed hB) hC) (subset_inter hB'.1 hAC)
    inter_subset_right with heq | heq
  · exact heq ▸ inter_mem hB hC𝒜
  · exact absurd (inter_eq_right.1 heq) hB'.2

/-- For closed sets `A ⊂ C`, the closure system `respecting p A C` is meet-irreducible if and only
if `C` covers `A` among the closed sets. -/
theorem infIrred_respecting_iff (hA : p A) (hC : p C) (hAC : A ⊂ C) :
    InfIrred (respecting p A C) ↔
      ∀ D, p D → A ⊆ D → D ⊆ C → D = A ∨ D = C := by
  constructor
  · intro h D hD hAD hDC
    by_contra! hne
    rcases h.2 (respecting_inf_respecting hAD hDC) with heq | heq
    · have hD' : D ∈ respecting p A C := heq ▸ ⟨hD, fun _ ↦ Subset.rfl⟩
      exact hne.2 (Subset.antisymm hDC (hD'.2 hAD))
    · have hA' : A ∈ respecting p D C :=
        ⟨hA, fun h' ↦ absurd (Subset.antisymm h' hAD) hne.1⟩
      exact notMem_respecting hAC (heq ▸ hA')
  · intro hcov
    refine ⟨not_isMax_iff_ne_top.2 fun htop ↦ notMem_respecting hAC (htop ▸ mem_top.2 hA),
      fun ℬ 𝒞 hinf ↦ ?_⟩
    by_contra! hne
    have hℬ : respecting p A C < ℬ := lt_of_le_of_ne (hinf ▸ inf_le_left) hne.1.symm
    have h𝒞 : respecting p A C < 𝒞 := lt_of_le_of_ne (hinf ▸ inf_le_right) hne.2.symm
    exact notMem_respecting hAC (hinf ▸ mem_inf.2
      ⟨mem_of_respecting_lt hC hAC.subset hcov hℬ, mem_of_respecting_lt hC hAC.subset hcov h𝒞⟩)

/-- Every closure system is the infimum of the closure systems `respecting p A C`,
where `A` ranges over the closed sets it misses and `C` is the closure of `A`. -/
theorem sInf_respecting_closure (𝒜 : ClosureSubsystem p) :
    sInf {ℳ | ∃ A, p A ∧ A ∉ 𝒜 ∧ ℳ = respecting p A (𝒜.closure A)} = 𝒜 := by
  ext B
  rw [mem_carrier, mem_carrier, mem_sInf]
  constructor
  · rintro ⟨hB, h⟩
    by_contra hB'
    exact hB' (closure_eq_self_iff.1 (Subset.antisymm
      ((h _ ⟨B, hB, hB', rfl⟩).2 Subset.rfl) subset_closure))
  · rintro hB
    refine ⟨𝒜.isClosed hB, ?_⟩
    rintro _ ⟨A, -, -, rfl⟩
    exact ⟨𝒜.isClosed hB, closure_subset hB⟩

/-- For a finite ground set, every meet-irreducible closure system consists of the
closed sets respecting an implication `A → C`, where `C` covers `A` among the closed sets. -/
theorem InfIrred.exists_respecting [Finite α] (h : InfIrred 𝒜) :
    ∃ A C, p A ∧ p C ∧ A ⊂ C ∧
      (∀ D, p D → A ⊆ D → D ⊆ C → D = A ∨ D = C) ∧ 𝒜 = respecting p A C := by
  have hfin := toFinite {ℳ | ∃ A, p A ∧ A ∉ 𝒜 ∧ ℳ = respecting p A (𝒜.closure A)}
  obtain ⟨ℳ, hℳ, rfl⟩ := h.finset_inf_eq (s := hfin.toFinset) (f := id) (by
    rw [Finset.inf_id_eq_sInf, hfin.coe_toFinset, sInf_respecting_closure])
  obtain ⟨A, hA, hA', hℳ⟩ := hfin.mem_toFinset.1 hℳ
  have hC : p ((id ℳ).closure A) := (id ℳ).isClosed closure_mem
  have hAC : A ⊂ (id ℳ).closure A :=
    subset_closure.ssubset_of_ne fun heq ↦ hA' (closure_eq_self_iff.1 heq.symm)
  refine ⟨A, _, hA, hC, hAC, ?_, hℳ⟩
  rw [← infIrred_respecting_iff hA hC hAC, ← hℳ]
  exact h

/-- The pairs of closed sets `A ⊂ C` such that `C` covers `A` among the closed sets. -/
def IsCoverPair (p : Set α → Prop) (q : Set α × Set α) : Prop :=
  p q.1 ∧ p q.2 ∧ q.1 ⊂ q.2 ∧ ∀ D, p D → q.1 ⊆ D → D ⊆ q.2 → D = q.1 ∨ D = q.2

/-- For a finite ground set, the covering pairs of closed sets correspond bijectively to the
meet-irreducible elements of the lattice of closure systems. -/
noncomputable def coverEquivInfIrred [Finite α] (p : Set α → Prop) [IsClosureSystem p] :
    {q : Set α × Set α // IsCoverPair p q} ≃ {𝒜 : ClosureSubsystem p // InfIrred 𝒜} :=
  Equiv.ofBijective
    (fun q ↦ ⟨respecting p q.1.1 q.1.2,
      (infIrred_respecting_iff q.2.1 q.2.2.1 q.2.2.2.1).2 q.2.2.2.2⟩)
    ⟨fun q q' h ↦ by
      have := (respecting_inj q.2.1 q.2.2.1 q.2.2.2.1 q'.2.1 q'.2.2.1 q'.2.2.2.1).1
        (congrArg Subtype.val h)
      exact Subtype.ext (Prod.ext this.1 this.2),
    fun 𝒜 ↦ by
      obtain ⟨A, C, hA, hC, hAC, hcov, h𝒜⟩ := InfIrred.exists_respecting 𝒜.2
      exact ⟨⟨(A, C), hA, hC, hAC, hcov⟩, Subtype.ext h𝒜.symm⟩⟩

@[simp]
theorem coe_coverEquivInfIrred [Finite α] (q : {q : Set α × Set α // IsCoverPair p q}) :
    (coverEquivInfIrred p q : ClosureSubsystem p) = respecting p q.1.1 q.1.2 :=
  rfl

/-- For a finite ground set, the number of meet-irreducible closure systems is the number of
covering pairs of closed sets. -/
theorem natCard_infIrred_eq_natCard_isCoverPair [Finite α] (p : Set α → Prop) [IsClosureSystem p] :
    Nat.card {𝒜 : ClosureSubsystem p // InfIrred 𝒜} =
      Nat.card {q : Set α × Set α // IsCoverPair p q} :=
  Nat.card_congr (coverEquivInfIrred p).symm

/-! ### Distributivity -/

/-- If the closed sets form a chain, the join of two closure systems is their union. -/
theorem mem_sup_of_total (h : ∀ A B, p A → p B → A ⊆ B ∨ B ⊆ A) :
    A ∈ 𝒜 ⊔ ℬ ↔ A ∈ 𝒜 ∨ A ∈ ℬ := by
  refine ⟨fun hA ↦ ?_, fun hA ↦ hA.elim (le_def.1 le_sup_left ·) (le_def.1 le_sup_right ·)⟩
  obtain ⟨A₁, h₁, A₂, h₂, rfl⟩ := mem_sup.1 hA
  rcases h A₁ A₂ (𝒜.isClosed h₁) (ℬ.isClosed h₂) with h' | h'
  · exact .inl (by rwa [inter_eq_left.2 h'])
  · exact .inr (by rwa [inter_eq_right.2 h'])

/-- The lattice of closure systems is distributive if and only if the closed sets form a
chain. -/
theorem sup_inf_le_iff_total :
    (∀ 𝒜 ℬ 𝒞 : ClosureSubsystem p, (𝒜 ⊔ ℬ) ⊓ (𝒜 ⊔ 𝒞) ≤ 𝒜 ⊔ ℬ ⊓ 𝒞) ↔
      ∀ A B, p A → p B → A ⊆ B ∨ B ⊆ A := by
  constructor
  · intro h A B hA hB
    by_contra! hne
    have hmem : A ∩ B ∈ pair A hA ⊔ pair B hB ⊓ pair (A ∩ B) (IsClosureSystem.inter_mem hA hB) :=
      le_def.1 (h _ _ _) (mem_inf.2 ⟨mem_sup.2 ⟨A, self_mem_pair, B, self_mem_pair, rfl⟩,
        le_def.1 le_sup_right self_mem_pair⟩)
    obtain ⟨A₁, h₁, A₂, h₂, heq⟩ := mem_sup.1 hmem
    have hA₂ : A₂ = univ := by
      rcases (mem_inf.1 h₂).1 with h' | rfl
      · exact h'
      rcases (mem_inf.1 h₂).2 with h' | h'
      · exact h'
      · exact absurd (inter_eq_right.1 h'.symm) hne.2
    rw [hA₂, inter_univ] at heq
    rcases h₁ with rfl | rfl
    · exact hne.1 fun x _ ↦ (heq ▸ mem_univ x : x ∈ A ∩ B).2
    · exact hne.1 (inter_eq_left.1 heq.symm)
  · intro h 𝒜 ℬ 𝒞
    refine le_def.2 fun A hA ↦ ?_
    simp only [mem_inf, mem_sup_of_total h] at hA ⊢
    tauto

/-- If the closed sets form a chain, the lattice of closure systems is distributive. -/
@[implicit_reducible]
def distribLattice (h : ∀ A B, p A → p B → A ⊆ B ∨ B ⊆ A) :
    DistribLattice (ClosureSubsystem p) :=
  { (inferInstance : Lattice (ClosureSubsystem p)) with
    le_sup_inf := (sup_inf_le_iff_total.2 h) }

/-! ### Join-semidistributivity -/

/-- If the closed sets satisfy the ascending chain condition, in particular for a finite ground
set, the lattice of closure systems is join-semidistributive. -/
theorem sup_eq_sup_inf_of_sup_eq_sup [IsNoetherianClosureSystem p] (h : 𝒜 ⊔ ℬ = 𝒜 ⊔ 𝒞) :
    𝒜 ⊔ ℬ = 𝒜 ⊔ ℬ ⊓ 𝒞 := by
  refine le_antisymm (le_def.2 fun D hD₀ ↦ ?_) (sup_le_sup_left inf_le_left _)
  refine IsNoetherianClosureSystem.induction (p := p)
    (motive := fun D ↦ D ∈ 𝒜 ⊔ ℬ → D ∈ 𝒜 ⊔ ℬ ⊓ 𝒞) ((𝒜 ⊔ ℬ).isClosed hD₀) (fun D _ ih hD ↦ ?_) hD₀
  obtain ⟨A, hA, B, hB, hAB⟩ := mem_sup.1 hD
  obtain ⟨A', hA', C, hC, hAC⟩ := mem_sup.1 (h ▸ hD)
  by_cases h₁ : D = B
  · by_cases h₂ : D = C
    · exact le_def.1 le_sup_right (mem_inf.2 ⟨h₁ ▸ hB, h₂ ▸ hC⟩)
    · have hlt : D ⊂ C := (hAC ▸ inter_subset_right).ssubset_of_ne h₂
      have hC' : C ∈ 𝒜 ⊔ ℬ := h ▸ le_def.1 le_sup_right hC
      exact hAC ▸ inter_mem (le_def.1 le_sup_left hA') (ih C ((𝒜 ⊔ ℬ).isClosed hC') hlt hC')
  · have hlt : D ⊂ B := (hAB ▸ inter_subset_right).ssubset_of_ne h₁
    exact hAB ▸ inter_mem (le_def.1 le_sup_left hA)
      (ih B (ℬ.isClosed hB) hlt (le_def.1 le_sup_right hB))

/-! ### Join-pseudocomplements -/

/-- The *join-pseudocomplement* of a closure system `𝒜` of closed sets: the meet of all closure
systems whose join with `𝒜` is the system of all closed sets. -/
def joinPseudocompl (𝒜 : ClosureSubsystem p) : ClosureSubsystem p :=
  sInf {ℬ | 𝒜 ⊔ ℬ = ⊤}

/-! ### Meet-distributivity -/

/-- The closed sets of `ℬ` that are not intersections of other closed sets of `ℬ`. -/
def irreducibles (ℬ : ClosureSubsystem p) : Set (Set α) :=
  {A | A ∈ ℬ ∧ ⋂₀ {B | B ∈ ℬ ∧ A ⊂ B} ≠ A}

/-- The closure system obtained from `ℬ` by keeping, among its irreducible closed sets, only
those in `J`. -/
def restrictIrreducibles (ℬ : ClosureSubsystem p) (J : Set (Set α)) : ClosureSubsystem p where
  carrier := {B | B ∈ ℬ ∧ (B ∈ ℬ.irreducibles → B ∈ J)}
  sInter_mem' S hS := by
    refine ⟨ℬ.sInter_mem fun B hB ↦ (hS hB).1, fun hirr ↦ ?_⟩
    by_cases hmem : ⋂₀ S ∈ S
    · exact (hS hmem).2 hirr
    · refine absurd (Subset.antisymm ?_ (subset_sInter fun B hB ↦ hB.2.subset)) hirr.2
      refine sInter_subset_sInter fun B hB ↦ ⟨(hS hB).1, ?_⟩
      exact (sInter_subset_of_mem hB).ssubset_of_ne fun heq ↦ hmem (heq ▸ hB)
  isClosed' _ hB := ℬ.isClosed hB.1

omit [IsClosureSystem p] in
@[simp]
theorem mem_restrictIrreducibles {J : Set (Set α)} :
    B ∈ ℬ.restrictIrreducibles J ↔ B ∈ ℬ ∧ (B ∈ ℬ.irreducibles → B ∈ J) :=
  Iff.rfl

omit [IsClosureSystem p] in
theorem restrictIrreducibles_le {J : Set (Set α)} : ℬ.restrictIrreducibles J ≤ ℬ :=
  le_def.2 fun _ hB ↦ hB.1

/-- Removing one irreducible closed set yields a lower cover. -/
theorem restrictIrreducibles_covBy (hA : A ∈ ℬ.irreducibles) :
    ℬ.restrictIrreducibles (ℬ.irreducibles \ {A}) ⋖ ℬ := by
  refine covBy_iff.2 ⟨A, fun h ↦ (h.2 hA).2 rfl, Set.ext fun B ↦ ?_⟩
  simp only [mem_carrier, mem_insert_iff, mem_restrictIrreducibles, mem_sdiff,
    mem_singleton_iff]
  by_cases hB : B = A
  · simp [hB, hA.1]
  · simp [hB]

/-- The lower covers of `ℬ` are obtained by removing one irreducible closed set. -/
theorem covBy_iff_exists_irreducibles :
    𝒜 ⋖ ℬ ↔ ∃ A ∈ ℬ.irreducibles, 𝒜.carrier = {B | B ∈ ℬ ∧ B ≠ A} := by
  constructor
  · intro h
    obtain ⟨A, hA, hℬ⟩ := covBy_iff.1 h
    have hmem : ∀ B, B ∈ ℬ → B = A ∨ B ∈ 𝒜 := fun B hB ↦
      (hℬ ▸ mem_carrier.2 hB : B ∈ insert A 𝒜.carrier)
    refine ⟨A, ⟨mem_carrier.1 (hℬ ▸ mem_insert A _), fun heq ↦ hA ?_⟩, Set.ext fun B ↦
      ⟨fun hB ↦ ⟨le_def.1 h.le hB, fun h' ↦ hA (h' ▸ hB)⟩,
        fun hB ↦ (hmem B hB.1).resolve_left hB.2⟩⟩
    rw [← heq]
    exact 𝒜.sInter_mem fun B hB ↦ (hmem B hB.1).resolve_left hB.2.ne'
  · rintro ⟨A, hA, h𝒜⟩
    convert restrictIrreducibles_covBy hA using 1
    refine ClosureSubsystem.ext (h𝒜.trans (Set.ext fun B ↦ ?_))
    simp only [mem_ofPred, mem_carrier, mem_restrictIrreducibles, mem_sdiff, mem_singleton_iff]
    refine and_congr_right fun hB ↦ ⟨fun h _ ↦ ⟨‹_›, h⟩, fun h hBA ↦ (h (hBA ▸ hA)).2 hBA⟩

/-- The closure system of the closed sets of `ℬ` that are intersections of other closed sets. -/
def core (ℬ : ClosureSubsystem p) : ClosureSubsystem p :=
  ℬ.restrictIrreducibles ∅

omit [IsClosureSystem p] in
theorem mem_core : B ∈ ℬ.core ↔ B ∈ ℬ ∧ B ∉ ℬ.irreducibles :=
  Iff.rfl

/-- The core of `ℬ` is the meet of the lower covers of `ℬ`. -/
theorem core_eq_inf_sInf_covBy (ℬ : ClosureSubsystem p) : ℬ.core = ℬ ⊓ sInf {𝒜 | 𝒜 ⋖ ℬ} := by
  ext B
  rw [mem_carrier, mem_carrier, mem_inf, mem_sInf, mem_core]
  refine and_congr_right fun hB ↦ ⟨fun hirr ↦ ⟨ℬ.isClosed hB, fun 𝒜 h𝒜 ↦ ?_⟩, fun h hirr ↦ ?_⟩
  · obtain ⟨A, hA, h𝒜⟩ := covBy_iff_exists_irreducibles.1 h𝒜
    exact mem_carrier.1 (h𝒜 ▸ ⟨hB, fun h ↦ hirr (h ▸ hA)⟩)
  · exact ((h.2 _ (restrictIrreducibles_covBy hirr)).2 hirr).2 rfl

/-- The lattice of closure systems is **meet-distributive**: the interval between a
closure system `ℬ` and the meet of its lower covers is a Boolean lattice, namely the powerset of
the irreducible closed sets of `ℬ`. -/
def IccCoreIso (ℬ : ClosureSubsystem p) : Set.Icc ℬ.core ℬ ≃o Set ℬ.irreducibles :=
  Equiv.toOrderIso
    { toFun 𝒜 := {A | A.1 ∈ 𝒜.1}
      invFun J := ⟨ℬ.restrictIrreducibles (Subtype.val '' J),
        le_def.2 fun _ hB ↦ ⟨hB.1, fun h ↦ absurd h hB.2⟩, restrictIrreducibles_le⟩
      left_inv 𝒜 := by
        refine Subtype.ext (ClosureSubsystem.ext (Set.ext fun B ↦ ⟨fun hB ↦ ?_, fun hB ↦
          ⟨le_def.1 𝒜.2.2 hB, fun h ↦ ⟨⟨B, h⟩, hB, rfl⟩⟩⟩))
        by_cases hirr : B ∈ ℬ.irreducibles
        · obtain ⟨A, hA, rfl⟩ := hB.2 hirr
          exact hA
        · exact le_def.1 𝒜.2.1 ⟨hB.1, hirr⟩
      right_inv J := by
        ext A
        refine ⟨fun h ↦ ?_, fun h ↦ ⟨A.2.1, fun _ ↦ ⟨A, h, rfl⟩⟩⟩
        obtain ⟨A', hA', heq⟩ := h.2 A.2
        exact Subtype.ext heq ▸ hA' }
    (fun _ _ h _ hA ↦ le_def.1 h hA)
    (fun _ _ h ↦ le_def.2 fun _ hB ↦ ⟨hB.1, fun hirr ↦ image_mono h (hB.2 hirr)⟩)

/-! ### An explicit description of the join-pseudocomplement -/

/-- Under the ascending chain condition, every closure system is generated by its
`⋂`-irreducible members. -/
theorem le_generate_irreducibles [IsNoetherianClosureSystem p] (𝒜 : ClosureSubsystem p) :
    𝒜 ≤ generate p 𝒜.irreducibles := by
  refine le_def.2 fun A hA₀ ↦ ?_
  refine IsNoetherianClosureSystem.induction (p := p)
    (motive := fun A ↦ A ∈ 𝒜 → A ∈ generate p 𝒜.irreducibles) (𝒜.isClosed hA₀)
    (fun A _ ih hA ↦ ?_) hA₀
  by_cases hirr : ⋂₀ {B | B ∈ 𝒜 ∧ A ⊂ B} = A
  · have := sInter_mem (𝒜 := generate p 𝒜.irreducibles) (S := {B | B ∈ 𝒜 ∧ A ⊂ B})
      fun B hB ↦ ih B (𝒜.isClosed hB.1) hB.2 hB.1
    rwa [hirr] at this
  · exact generate_le_iff.1 le_rfl A ⟨hA, hirr⟩ (𝒜.isClosed hA)

/-- If the join of two closure systems contains all closed sets, then every closed set which is
not an intersection of other closed sets lies in one of them. -/
theorem mem_or_mem_of_sup_eq_top (h : 𝒜 ⊔ ℬ = ⊤)
    (hA : A ∈ (⊤ : ClosureSubsystem p).irreducibles) : A ∈ 𝒜 ∨ A ∈ ℬ := by
  have hmem : A ∈ 𝒜 ⊔ ℬ := by rw [h]; exact hA.1
  obtain ⟨A₁, h₁, A₂, h₂, rfl⟩ := mem_sup.1 hmem
  by_contra hne
  rw [not_or] at hne
  refine hA.2 (Subset.antisymm ?_ (subset_sInter fun B hB ↦ hB.2.subset))
  have h₁' : A₁ ∩ A₂ ⊂ A₁ := inter_subset_left.ssubset_of_ne fun heq ↦ hne.1 (by rwa [heq])
  have h₂' : A₁ ∩ A₂ ⊂ A₂ := inter_subset_right.ssubset_of_ne fun heq ↦ hne.2 (by rwa [heq])
  exact subset_inter (sInter_subset_of_mem ⟨mem_top.2 (𝒜.isClosed h₁), h₁'⟩)
    (sInter_subset_of_mem ⟨mem_top.2 (ℬ.isClosed h₂), h₂'⟩)

/-- Under the ascending chain condition, the join of two closure systems contains all closed
sets if and only if every closed set which is not an intersection of other closed sets lies in
one of them. -/
theorem sup_eq_top_iff_irreducibles [IsNoetherianClosureSystem p] :
    𝒜 ⊔ ℬ = ⊤ ↔ ∀ A ∈ (⊤ : ClosureSubsystem p).irreducibles, A ∈ 𝒜 ∨ A ∈ ℬ := by
  refine ⟨fun h A hA ↦ mem_or_mem_of_sup_eq_top h hA,
    fun h ↦ top_unique (le_def.2 fun D hD₀ ↦ ?_)⟩
  refine IsNoetherianClosureSystem.induction (p := p)
    (motive := fun D ↦ D ∈ (⊤ : ClosureSubsystem p) → D ∈ 𝒜 ⊔ ℬ) (mem_top.1 hD₀)
    (fun D _ ih hD ↦ ?_) hD₀
  by_cases hirr : ⋂₀ {B | B ∈ (⊤ : ClosureSubsystem p) ∧ D ⊂ B} = D
  · have := sInter_mem (𝒜 := 𝒜 ⊔ ℬ) (S := {B | B ∈ (⊤ : ClosureSubsystem p) ∧ D ⊂ B})
      fun B hB ↦ ih B (mem_top.1 hB.1) hB.2 hB.1
    rwa [hirr] at this
  · exact (h D ⟨hD, hirr⟩).elim (fun h' ↦ le_def.1 le_sup_left h')
      fun h' ↦ le_def.1 le_sup_right h'

/-- Under the ascending chain condition, the join of a closure system with its
join-pseudocomplement is the system of all closed sets. -/
theorem sup_joinPseudocompl [IsNoetherianClosureSystem p] (𝒜 : ClosureSubsystem p) :
    𝒜 ⊔ 𝒜.joinPseudocompl = ⊤ := by
  refine sup_eq_top_iff_irreducibles.2 fun A hA ↦ ?_
  by_cases h : A ∈ 𝒜
  · exact .inl h
  · exact .inr (mem_sInf.2 ⟨mem_top.1 hA.1, fun ℬ hℬ ↦
      (mem_or_mem_of_sup_eq_top hℬ hA).resolve_left h⟩)

/-- Under the ascending chain condition, in particular for a finite ground set, the lattice of
closure systems is **join-pseudocomplemented**: `𝒜.joinPseudocompl` is the least closure system
whose join with `𝒜` is the system of all closed sets. -/
theorem joinPseudocompl_le_iff [IsNoetherianClosureSystem p] :
    𝒜.joinPseudocompl ≤ ℬ ↔ 𝒜 ⊔ ℬ = ⊤ :=
  ⟨fun h ↦ top_unique (𝒜.sup_joinPseudocompl ▸ sup_le_sup_left h 𝒜), fun h ↦ sInf_le h⟩

theorem isLeast_joinPseudocompl [IsNoetherianClosureSystem p] (𝒜 : ClosureSubsystem p) :
    IsLeast {ℬ | 𝒜 ⊔ ℬ = ⊤} 𝒜.joinPseudocompl :=
  ⟨𝒜.sup_joinPseudocompl, fun _ h ↦ joinPseudocompl_le_iff.2 h⟩

/-- Under the ascending chain condition, the join-pseudocomplement of `𝒜` is generated by the
closed sets which are not intersections of other closed sets and do not belong to `𝒜`. -/
theorem joinPseudocompl_eq_generate [IsNoetherianClosureSystem p] (𝒜 : ClosureSubsystem p) :
    𝒜.joinPseudocompl =
      generate p {A | A ∈ (⊤ : ClosureSubsystem p).irreducibles ∧ A ∉ 𝒜} := by
  refine le_antisymm (joinPseudocompl_le_iff.2 (sup_eq_top_iff_irreducibles.2 fun A hA ↦ ?_))
    (generate_le_iff.2 fun A hA _ ↦ ?_)
  · by_cases h : A ∈ 𝒜
    · exact .inl h
    · exact .inr (generate_le_iff.1 le_rfl A ⟨hA, h⟩ (mem_top.1 hA.1))
  · exact (sup_eq_top_iff_irreducibles.1 𝒜.sup_joinPseudocompl A hA.1).resolve_left hA.2

/-- Under the ascending chain condition, the closed sets of the join-pseudocomplement of `𝒜`
are the intersections of irreducible closed sets outside `𝒜`. -/
theorem mem_joinPseudocompl [IsNoetherianClosureSystem p] :
    B ∈ 𝒜.joinPseudocompl ↔ ∃ T : Set (Set α),
      (∀ A ∈ T, A ∈ (⊤ : ClosureSubsystem p).irreducibles ∧ A ∉ 𝒜) ∧ ⋂₀ T = B := by
  rw [joinPseudocompl_eq_generate, mem_generate]
  exact ⟨fun ⟨T, hT, _, h⟩ ↦ ⟨T, fun A hA ↦ hT hA, h⟩,
    fun ⟨T, hT, h⟩ ↦ ⟨T, fun A hA ↦ hT A hA, fun A hA ↦ mem_top.1 (hT A hA).1.1, h⟩⟩

/-! ### Instances of the general lattice properties -/

instance [IsNoetherianClosureSystem p] : IsJoinSemidistrib (ClosureSubsystem p) :=
  ⟨fun _ _ _ h ↦ sup_eq_sup_inf_of_sup_eq_sup h⟩

theorem isJoinPseudocompl_joinPseudocompl [IsNoetherianClosureSystem p]
    (𝒜 : ClosureSubsystem p) :
    IsJoinPseudocompl 𝒜 𝒜.joinPseudocompl :=
  𝒜.isLeast_joinPseudocompl

instance [IsNoetherianClosureSystem p] : IsJoinPseudocomplemented (ClosureSubsystem p) :=
  ⟨fun 𝒜 ↦ ⟨𝒜.joinPseudocompl, 𝒜.isJoinPseudocompl_joinPseudocompl⟩⟩

theorem lowerCore_eq_core (ℬ : ClosureSubsystem p) : lowerCore ℬ = ℬ.core :=
  ℬ.core_eq_inf_sInf_covBy.symm

instance : IsMeetDistrib (ClosureSubsystem p) :=
  .of_orderIso fun ℬ ↦ ⟨ℬ.irreducibles, by rw [lowerCore_eq_core]; exact ⟨ℬ.IccCoreIso⟩⟩

end ClosureSubsystem

end FCA
