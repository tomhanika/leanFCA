/-!
# The lattice of closure systems contained in a closure system

A *closure system* on a type `α` is a family of subsets of `α` closed under arbitrary
intersections. This file studies the closure systems contained in a fixed closure system, given
by a predicate `p : Set α → Prop`. Ordered by inclusion they form a complete lattice. For `p`
the predicate `fun _ ↦ True` this is the lattice of all closure systems on `α`
(Caspard and Monjardet); for `p` the closed sets of a closure operator `c` it is the lattice of
closure systems coarser than that of `c`.

## Main definitions

* `FCA.IsClosureSystem p`: the sets satisfying `p` are closed under arbitrary intersections.
* `FCA.IsNoetherianClosureSystem p`: the sets satisfying `p` satisfy the ascending chain
  condition.
* `FCA.ClosureSubsystem p`: the closure systems all of whose members satisfy `p`, a complete
  lattice under inclusion.
* `FCA.ClosureSubsystem.closure`: the closure of a set in a closure system.
* `FCA.ClosureSubsystem.generate p S`: the closure system generated by the members of `S`
  satisfying `p`.

## Main results

* `FCA.ClosureSubsystem.mem_inf`, `FCA.ClosureSubsystem.mem_sup`: the meet of two closure systems
  is their intersection, their join consists of the pairwise intersections of their members.
* `FCA.ClosureSubsystem.generate_le_iff`: `generate p S` is the least closure system containing
  the members of `S` satisfying `p`.

## References

* [N. Caspard, B. Monjardet, *The lattices of closure systems, closure operators, and
  implicational systems on a finite set: a survey*][caspard2003]
-/

@[expose] public section

open Set Function Order

namespace FCA

variable {α : Type*} {p : Set α → Prop}

/-- The sets satisfying `p` form a closure system: they are closed under arbitrary
intersections. -/
class IsClosureSystem (p : Set α → Prop) : Prop where
  /-- The sets satisfying `p` are closed under arbitrary intersections. -/
  sInter_mem : ∀ ⦃S : Set (Set α)⦄, (∀ A ∈ S, p A) → p (⋂₀ S)

theorem IsClosureSystem.univ_mem [IsClosureSystem p] : p univ := by
  simpa using IsClosureSystem.sInter_mem (p := p) (S := ∅) (by simp)

theorem IsClosureSystem.inter_mem [IsClosureSystem p] {A B : Set α} (hA : p A) (hB : p B) :
    p (A ∩ B) := by
  simpa using IsClosureSystem.sInter_mem (p := p) (S := {A, B}) (by simp [hA, hB])

/-- All sets form a closure system. -/
instance : IsClosureSystem fun _ : Set α ↦ True :=
  ⟨fun _ _ ↦ trivial⟩

/-- The closed sets of a closure operator form a closure system. -/
instance (c : ClosureOperator (Set α)) : IsClosureSystem c.IsClosed :=
  ⟨fun _ hS ↦ ClosureOperator.sInf_isClosed hS⟩

/-- The sets satisfying `p` satisfy the *ascending chain condition*: there is no infinite
strictly increasing sequence of such sets. This holds in particular on a finite type. -/
class IsNoetherianClosureSystem (p : Set α → Prop) : Prop where
  /-- Strict reverse inclusion is well-founded on the sets satisfying `p`. -/
  wf : WellFounded fun B A : {A : Set α // p A} ↦ (A : Set α) ⊂ B

instance [Finite α] : IsNoetherianClosureSystem p :=
  ⟨InvImage.wf (fun A : {A : Set α // p A} ↦ (A : Set α)) (wellFounded_gt (α := Set α))⟩

/-- Induction along strict supersets on the sets satisfying `p`, under the ascending chain
condition. -/
theorem IsNoetherianClosureSystem.induction [h : IsNoetherianClosureSystem p]
    {motive : Set α → Prop} {A : Set α} (hA : p A)
    (ih : ∀ A, p A → (∀ B, p B → A ⊂ B → motive B) → motive A) : motive A :=
  h.wf.induction (C := fun A ↦ motive A) ⟨A, hA⟩
    fun A ih' ↦ ih A A.2 fun B hB hAB ↦ ih' ⟨B, hB⟩ hAB

/-- A closure system on `α` all of whose members satisfy `p`. -/
@[ext]
structure ClosureSubsystem (p : Set α → Prop) where
  /-- The closed sets of the closure system. -/
  carrier : Set (Set α)
  /-- A closure system is closed under arbitrary intersections. -/
  sInter_mem' : ∀ ⦃S : Set (Set α)⦄, S ⊆ carrier → ⋂₀ S ∈ carrier
  /-- All closed sets satisfy `p`. -/
  isClosed' : ∀ ⦃A : Set α⦄, A ∈ carrier → p A

namespace ClosureSubsystem


variable {𝒜 ℬ : ClosureSubsystem p} {A B : Set α}

instance : Membership (Set α) (ClosureSubsystem p) :=
  ⟨fun 𝒜 A ↦ A ∈ 𝒜.carrier⟩

@[simp]
theorem mem_carrier : A ∈ 𝒜.carrier ↔ A ∈ 𝒜 :=
  Iff.rfl

@[simp]
theorem mem_mk {C : Set (Set α)} {h₁ h₂} : A ∈ (⟨C, h₁, h₂⟩ : ClosureSubsystem p) ↔ A ∈ C :=
  Iff.rfl

theorem carrier_injective : Injective (carrier : ClosureSubsystem p → Set (Set α)) :=
  fun _ _ ↦ ClosureSubsystem.ext

instance : PartialOrder (ClosureSubsystem p) :=
  .lift carrier carrier_injective

theorem le_def : 𝒜 ≤ ℬ ↔ ∀ ⦃A⦄, A ∈ 𝒜 → A ∈ ℬ :=
  Iff.rfl

theorem sInter_mem {S : Set (Set α)} (hS : ∀ A ∈ S, A ∈ 𝒜) : ⋂₀ S ∈ 𝒜 :=
  𝒜.sInter_mem' hS

theorem isClosed (hA : A ∈ 𝒜) : p A :=
  𝒜.isClosed' hA

theorem univ_mem (𝒜 : ClosureSubsystem p) : univ ∈ 𝒜 := by
  simpa using 𝒜.sInter_mem (S := ∅) (by simp)

theorem inter_mem (hA : A ∈ 𝒜) (hB : B ∈ 𝒜) : A ∩ B ∈ 𝒜 := by
  simpa using 𝒜.sInter_mem (S := {A, B}) (by simp [hA, hB])

/-! ### The closure of a set -/

/-- The closure of a set in a closure system. -/
def closure (𝒜 : ClosureSubsystem p) (A : Set α) : Set α :=
  ⋂₀ {B | B ∈ 𝒜 ∧ A ⊆ B}

theorem subset_closure : A ⊆ 𝒜.closure A :=
  subset_sInter fun _ hB ↦ hB.2

theorem closure_mem : 𝒜.closure A ∈ 𝒜 :=
  𝒜.sInter_mem fun _ hB ↦ hB.1

theorem closure_subset (hB : B ∈ 𝒜) (h : A ⊆ B) : 𝒜.closure A ⊆ B :=
  sInter_subset_of_mem ⟨hB, h⟩

theorem closure_eq_self_iff : 𝒜.closure A = A ↔ A ∈ 𝒜 :=
  ⟨fun h ↦ h ▸ closure_mem, fun h ↦ Subset.antisymm (closure_subset h Subset.rfl) subset_closure⟩

theorem closure_mono (𝒜 : ClosureSubsystem p) (h : A ⊆ B) : 𝒜.closure A ⊆ 𝒜.closure B :=
  closure_subset closure_mem (h.trans subset_closure)

section Lattice

variable [IsClosureSystem p]

/-- The closure system of all sets satisfying `p`. -/
def closeds (p : Set α → Prop) [IsClosureSystem p] : ClosureSubsystem p where
  carrier := {A | p A}
  sInter_mem' _ hS := IsClosureSystem.sInter_mem (p := p) hS
  isClosed' _ hA := hA

/-- The closure system consisting only of the whole set. -/
def trivial (p : Set α → Prop) [IsClosureSystem p] : ClosureSubsystem p where
  carrier := {univ}
  sInter_mem' S hS := by
    rw [mem_singleton_iff, sInter_eq_univ]
    exact fun A hA ↦ hS hA
  isClosed' := by
    rintro _ rfl
    exact IsClosureSystem.univ_mem

instance : InfSet (ClosureSubsystem p) where
  sInf 𝒮 :=
    { carrier := {A | p A ∧ ∀ 𝒜 ∈ 𝒮, A ∈ 𝒜}
      sInter_mem' := fun _ hS ↦
        ⟨IsClosureSystem.sInter_mem (p := p) fun _ hA ↦ (hS hA).1,
          fun 𝒜 h𝒜 ↦ 𝒜.sInter_mem fun _ hA ↦ (hS hA).2 𝒜 h𝒜⟩
      isClosed' := fun _ hA ↦ hA.1 }

theorem mem_sInf {𝒮 : Set (ClosureSubsystem p)} :
    A ∈ sInf 𝒮 ↔ p A ∧ ∀ 𝒜 ∈ 𝒮, A ∈ 𝒜 :=
  Iff.rfl

/-- The closure systems contained in a closure system form a complete lattice under
inclusion. -/
instance : CompleteLattice (ClosureSubsystem p) :=
  completeLatticeOfInf _ fun _ ↦
    ⟨fun _ h𝒜 ↦ le_def.2 fun _ hA ↦ (mem_sInf.1 hA).2 _ h𝒜, fun _ hℬ ↦ le_def.2 fun _ hA ↦
      mem_sInf.2 ⟨isClosed hA, fun _ h𝒜 ↦ le_def.1 (hℬ h𝒜) hA⟩⟩

@[simp]
theorem mem_top : A ∈ (⊤ : ClosureSubsystem p) ↔ p A :=
  ⟨isClosed, fun hA ↦ le_top (a := closeds p) hA⟩

theorem top_eq : (⊤ : ClosureSubsystem p) = closeds p :=
  ClosureSubsystem.ext (Set.ext fun _ ↦ mem_top)

@[simp]
theorem mem_bot : A ∈ (⊥ : ClosureSubsystem p) ↔ A = univ :=
  ⟨fun hA ↦ bot_le (a := trivial p) hA, fun hA ↦ hA ▸ univ_mem _⟩

theorem bot_eq : (⊥ : ClosureSubsystem p) = trivial p :=
  ClosureSubsystem.ext (Set.ext fun _ ↦ mem_bot)

/-- The intersection of two closure systems. -/
def inter (𝒜 ℬ : ClosureSubsystem p) : ClosureSubsystem p where
  carrier := {A | A ∈ 𝒜 ∧ A ∈ ℬ}
  sInter_mem' _ hS :=
    ⟨𝒜.sInter_mem fun _ hA ↦ (hS hA).1, ℬ.sInter_mem fun _ hA ↦ (hS hA).2⟩
  isClosed' _ hA := 𝒜.isClosed hA.1

/-- The meet of two closure systems is their intersection. -/
@[simp]
theorem mem_inf : A ∈ 𝒜 ⊓ ℬ ↔ A ∈ 𝒜 ∧ A ∈ ℬ :=
  ⟨fun hA ↦ ⟨le_def.1 inf_le_left hA, le_def.1 inf_le_right hA⟩, fun hA ↦
    le_def.1 (le_inf (le_def.2 fun _ h ↦ h.1) (le_def.2 fun _ h ↦ h.2) : inter 𝒜 ℬ ≤ _) hA⟩

/-- The closure system of all intersections of a member of `𝒜` with a member of `ℬ`. -/
def pairwiseInter (𝒜 ℬ : ClosureSubsystem p) : ClosureSubsystem p where
  carrier := {C | ∃ A ∈ 𝒜, ∃ B ∈ ℬ, A ∩ B = C}
  sInter_mem' S hS := by
    have hS' : ∀ C, C ∈ S → ∃ A, A ∈ 𝒜 ∧ ∃ B, B ∈ ℬ ∧ A ∩ B = C := fun C hC ↦ hS hC
    choose! f hf g hg hfg using hS'
    refine ⟨⋂₀ (f '' S), 𝒜.sInter_mem ?_, ⋂₀ (g '' S), ℬ.sInter_mem ?_, ?_⟩
    · rintro _ ⟨C, hC, rfl⟩
      exact hf C hC
    · rintro _ ⟨C, hC, rfl⟩
      exact hg C hC
    · ext x
      simp only [mem_inter_iff, mem_sInter, forall_mem_image]
      refine ⟨fun h C hC ↦ ?_, fun h ↦ ⟨fun C hC ↦ ?_, fun C hC ↦ ?_⟩⟩
      · rw [← hfg C hC]
        exact ⟨h.1 hC, h.2 hC⟩
      · have := h C hC
        rw [← hfg C hC] at this
        exact this.1
      · have := h C hC
        rw [← hfg C hC] at this
        exact this.2
  isClosed' := by
    rintro _ ⟨A, hA, B, hB, rfl⟩
    exact IsClosureSystem.inter_mem (𝒜.isClosed hA) (ℬ.isClosed hB)

/-- The join of two closure systems consists of the pairwise intersections of their members. -/
theorem mem_sup : A ∈ 𝒜 ⊔ ℬ ↔ ∃ A₁ ∈ 𝒜, ∃ A₂ ∈ ℬ, A₁ ∩ A₂ = A := by
  constructor
  · refine fun hA ↦ le_def.1 (sup_le (le_def.2 fun C hC ↦ ?_) (le_def.2 fun C hC ↦ ?_) :
      𝒜 ⊔ ℬ ≤ pairwiseInter 𝒜 ℬ) hA
    · exact ⟨C, hC, univ, ℬ.univ_mem, inter_univ C⟩
    · exact ⟨univ, 𝒜.univ_mem, C, hC, univ_inter C⟩
  · rintro ⟨A₁, hA₁, A₂, hA₂, rfl⟩
    exact inter_mem (le_def.1 le_sup_left hA₁) (le_def.1 le_sup_right hA₂)

theorem sup_eq : 𝒜 ⊔ ℬ = pairwiseInter 𝒜 ℬ :=
  ClosureSubsystem.ext (Set.ext fun _ ↦ mem_sup)


/-! ### Generated closure systems -/

/-- The closure system generated by the members of `S` satisfying `p`: all intersections of
such members. -/
def generate (p : Set α → Prop) [IsClosureSystem p] (S : Set (Set α)) : ClosureSubsystem p where
  carrier := {B | ∃ T ⊆ S, (∀ A ∈ T, p A) ∧ ⋂₀ T = B}
  sInter_mem' 𝒯 h𝒯 := by
    refine ⟨{M | M ∈ S ∧ p M ∧ ⋂₀ 𝒯 ⊆ M}, fun M hM ↦ hM.1, fun M hM ↦ hM.2.1,
      Subset.antisymm (subset_sInter fun B hB ↦ ?_) (subset_sInter fun M hM ↦ hM.2.2)⟩
    obtain ⟨T, hTS, hT, rfl⟩ := h𝒯 hB
    exact sInter_subset_sInter fun M hM ↦
      ⟨hTS hM, hT M hM, (sInter_subset_of_mem hB).trans (sInter_subset_of_mem hM)⟩
  isClosed' B hB := by
    obtain ⟨T, -, hT, rfl⟩ := hB
    exact IsClosureSystem.sInter_mem hT

theorem mem_generate {S : Set (Set α)} :
    B ∈ generate p S ↔ ∃ T ⊆ S, (∀ A ∈ T, p A) ∧ ⋂₀ T = B :=
  Iff.rfl

/-- `generate p S` is the least closure system containing the members of `S` satisfying `p`. -/
theorem generate_le_iff {S : Set (Set α)} :
    generate p S ≤ ℬ ↔ ∀ A ∈ S, p A → A ∈ ℬ := by
  refine ⟨fun h A hA hA' ↦ le_def.1 h
    ⟨{A}, singleton_subset_iff.2 hA, by simpa using hA', sInter_singleton A⟩, fun h ↦ le_def.2 ?_⟩
  rintro _ ⟨T, hTS, hT, rfl⟩
  exact ℬ.sInter_mem fun A hA ↦ h A (hTS hA) (hT A hA)

end Lattice

end ClosureSubsystem

end FCA
