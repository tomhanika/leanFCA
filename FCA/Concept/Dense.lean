module

public import Mathlib.Order.Concept

/-!
# Object concepts and attribute concepts are dense

Mathlib's `Mathlib.Order.Concept` defines the concept lattice `Concept α β r` of a relation
`r : α → β → Prop` (the *formal context* with objects `α`, attributes `β` and incidence `r`),
together with the object concepts `Concept.ofObject r a` and the attribute concepts
`Concept.ofAttribute r b`.

This file proves the density half of the basic theorem on concept lattices: every concept is the
supremum of the object concepts below it and the infimum of the attribute concepts above it.

## Main results

* `Concept.ofObjects_eq_iSup`: the concept generated by a set of objects is the supremum of the
  corresponding object concepts.
* `Concept.ofAttributes_eq_iInf`: the concept generated by a set of attributes is the infimum of
  the corresponding attribute concepts.
* `Concept.iSup_ofObject_extent`: the object concepts are supremum-dense.
* `Concept.iInf_ofAttribute_intent`: the attribute concepts are infimum-dense.

## References

* [B. Ganter, R. Wille, *Formal Concept Analysis: Mathematical Foundations*][ganter1999]
-/

@[expose] public section

open Set

namespace Concept

variable {α β : Type*} {r : α → β → Prop} {s : Set α} {t : Set β}

theorem ofObjects_eq_iSup (r : α → β → Prop) (s : Set α) :
    ofObjects r s = ⨆ a ∈ s, ofObject r a := by
  refine le_antisymm (ofObjects_le_iff.2 fun a ha => ?_) (iSup₂_le fun a ha => ?_)
  · exact singleton_subset_iff.1
      (ofObjects_le_iff.1 (le_iSup₂ (f := fun a (_ : a ∈ s) => ofObject r a) a ha))
  · exact ofObjects_le_iff.2 (singleton_subset_iff.2 (subset_lowerPolar_upperPolar r s ha))

theorem ofAttributes_eq_iInf (r : α → β → Prop) (t : Set β) :
    ofAttributes r t = ⨅ b ∈ t, ofAttribute r b := by
  refine le_antisymm (le_iInf₂ fun b hb => ?_) (le_ofAttributes_iff.2 fun b hb => ?_)
  · exact le_ofAttributes_iff.2 (singleton_subset_iff.2 (subset_upperPolar_lowerPolar r t hb))
  · exact singleton_subset_iff.1
      (le_ofAttributes_iff.1 (iInf₂_le (f := fun b (_ : b ∈ t) => ofAttribute r b) b hb))

/-- The object concepts are supremum-dense in the concept lattice: every concept is the supremum
of the object concepts of the objects in its extent. -/
theorem iSup_ofObject_extent (c : Concept α β r) : ⨆ a ∈ c.extent, ofObject r a = c := by
  rw [← ofObjects_eq_iSup, ofObjects_extent]

/-- The attribute concepts are infimum-dense in the concept lattice: every concept is the infimum
of the attribute concepts of the attributes in its intent. -/
theorem iInf_ofAttribute_intent (c : Concept α β r) : ⨅ b ∈ c.intent, ofAttribute r b = c := by
  rw [← ofAttributes_eq_iInf, ofAttributes_intent]

/-- An object lies in the extent of a concept iff its object concept lies below the concept. -/
theorem ofObject_le_iff {a : α} {c : Concept α β r} : ofObject r a ≤ c ↔ a ∈ c.extent :=
  ofObjects_le_iff.trans singleton_subset_iff

/-- An attribute lies in the intent of a concept iff its attribute concept lies above the
concept. -/
theorem le_ofAttribute_iff {b : β} {c : Concept α β r} : c ≤ ofAttribute r b ↔ b ∈ c.intent :=
  le_ofAttributes_iff.trans singleton_subset_iff

end Concept
